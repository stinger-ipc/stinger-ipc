{%- import "partials/codec.jinja2" as codec -%}
<!DOCTYPE html>
<html>
  <head>
    <title>{{stinger.title}} Web Interface</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.2.96/css/materialdesignicons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="./styles.css" />
    <!--
    This is automatically generated code.
    {%if stinger.license%}LICENSE: {{stinger.license}}{%endif%}
    -->
  </head>
  {%macro arglist(arg_list, model_parts, read_only) -%}
  {%set modelpath %}{%for part in model_parts%}{%if not loop.first%}.{%endif%}{{part|lowerCamelCase}}{%endfor%}{%endset%}
  <table class="arglist">
  {%for arg in arg_list %}
    <tr class="argrow">
      <td class="arg-name-cell">
        <div class="arg-name">{{ arg.name }}</div>
        {%if arg.description %}
        <div class="arg-description">{{ arg.description }}</div>
        {%endif%}
      </td>
      <td class="arg-value-cell">
        {%if arg.arg_type|lower == "argtype.primitive"%}
        {%if arg.primitive_type|lower == "argprimitivetype.integer"%}
        <input {%if read_only%}disabled {%endif%}type="number" step="1" ng-model="{{modelpath}}.{{arg.name}}" />
        {%elif arg.primitive_type|lower == "argprimitivetype.float"%}
        <input {%if read_only%}disabled {%endif%}type="number" step="any" ng-model="{{modelpath}}.{{arg.name}}" />
        {%elif arg.primitive_type|lower == "argprimitivetype.boolean"%}
        <input {%if read_only%}disabled {%endif%}type="checkbox" ng-model="{{modelpath}}.{{arg.name}}" />
        {%else%}
        <input {%if read_only%}disabled {%endif%}type="text" ng-model="{{modelpath}}.{{arg.name}}" />
        {%endif%}
        {%elif arg.arg_type|lower == "argtype.enum"%}
        <select {%if read_only%}disabled {%endif%}ng-model="{{modelpath}}.{{arg.name}}" ng-options="n.id as n.name for n in enums.{{arg.enum.name|lowerCamelCase}}">
        </select>
        {%elif arg.arg_type|lower == "argtype.list"%}
        <input {%if read_only%}disabled {%endif%}type="text"  ng-model="{{modelpath}}.{{arg.name}}" placeholder="Comma-separated values" />
        {%elif arg.arg_type|lower == "argtype.struct"%}
        <div class="struct-arg">
          {%set new_model_parts = model_parts + [arg.name] %}
          {{ arglist(arg.values, new_model_parts, read_only) }}
        </div>
        {%elif arg.arg_type|lower == "argtype.binary"%}
        {#- A binary arg declares a contentType, so one that carries an image, a sound or
            a video can be shown as media rather than as the base64 text that came over
            the wire, and can be filled from a local file rather than pasted base64. #}
        {%- set is_image = arg.content_type and arg.content_type.startswith('image/') %}
        {%- set is_audio = arg.content_type and arg.content_type.startswith('audio/') %}
        {%- set is_video = arg.content_type and arg.content_type.startswith('video/') %}
        {%if is_image or is_audio or is_video%}
        {%if is_image%}
        <img class="binary-media binary-image" alt="{{arg.name}}" ng-if="{{modelpath}}.{{arg.name}}" binary-media="{{modelpath}}.{{arg.name}}" binary-media-type="{{arg.content_type}}" />
        {%elif is_audio%}
        <audio class="binary-media binary-audio" controls preload="metadata" ng-if="{{modelpath}}.{{arg.name}}" binary-media="{{modelpath}}.{{arg.name}}" binary-media-type="{{arg.content_type}}"></audio>
        {%else%}
        <video class="binary-media binary-video" controls preload="metadata" ng-if="{{modelpath}}.{{arg.name}}" binary-media="{{modelpath}}.{{arg.name}}" binary-media-type="{{arg.content_type}}"></video>
        {%endif%}
        <div class="binary-empty" ng-if="!{{modelpath}}.{{arg.name}}">no <code>{{arg.content_type}}</code> data</div>
        {%if not read_only%}
        <input type="file" class="binary-file" accept="{{arg.content_type}}" binary-file="{{modelpath}}.{{arg.name}}" />
        <input type="text" class="binary-base64" ng-model="{{modelpath}}.{{arg.name}}" placeholder="or paste base64 {{arg.content_type}} data" />
        {%endif%}
        {%else%}
        Binary: <input {%if read_only%}disabled {%endif%}type="text" ng-model="{{modelpath}}.{{arg.name}}" />
        {%endif%}
        {%elif arg.arg_type|lower == "argtype.array"%}
        {%if arg.element.arg_type|lower == "argtype.struct"%}
        <table class="arglist array-of-struct">
          <thead>
            <tr>
              {%for member in arg.element.values %}
              <th class="arg-name">{{ member.name }}</th>
              {%endfor%}
              {%if not read_only%}<th></th>{%endif%}
            </tr>
          </thead>
          <tbody>
            <tr ng-repeat="(index, item) in {{modelpath}}.{{arg.name}} track by $index" class="argrow">
              {%for member in arg.element.values %}
              <td class="arg-value-cell">
                {%if member.arg_type|lower == "argtype.enum"%}
                <select {%if read_only%}disabled {%endif%}ng-model="{{modelpath}}.{{arg.name}}[index].{{member.name}}" ng-options="n.id as n.name for n in enums.{{member.enum.name|lowerCamelCase}}"></select>
                {%else%}
                <input {%if read_only%}disabled {%endif%}type="text" ng-model="{{modelpath}}.{{arg.name}}[index].{{member.name}}" />
                {%endif%}
              </td>
              {%endfor%}
              {%if not read_only%}
              <td><button type="button" class="publish-button" ng-click="{{modelpath}}.{{arg.name}}.splice(index, 1)">✕</button></td>
              {%endif%}
            </tr>
          </tbody>
          {%if not read_only%}
          <tfoot>
            <tr>
              <td colspan="{{ arg.element.values|length + 1 }}">
                <button type="button" class="publish-button" ng-click="{{modelpath}}.{{arg.name}}.push({})">+ Add row</button>
              </td>
            </tr>
          </tfoot>
          {%endif%}
        </table>
        {%else%}
        <span ng-repeat="(index, item) in {{modelpath}}.{{arg.name}} track by $index">
          <input {%if read_only%}disabled {%endif%}type="text" ng-model="{{modelpath}}.{{arg.name}}[index]" />
        </span>
        {%endif%}
        {%else%}
        <input {%if read_only%}disabled {%endif%}type="text" ng-model="{{modelpath}}.{{arg.name}}" placeholder="(unknown type)" />
        {%endif%} 
      </td>
    </tr>
  {%endfor%}
  </table>
  {%- endmacro %}
  <body ng-app="myApp" ng-controller="myCtrl">
    <div class="infobox-background" ng-show="!online || showoutput" id="offline">Connecting</div>

    <div class="interface-box">
      <h1>{{stinger.title}}</h1>
      <p id="interface-summary"><i>{{stinger.summary}}</i></p>
      <p id="interface-doc">
      {%markdown%}
      {{stinger.documentation}}
      {%endmarkdown%}
      </p>
    </div>

    <!------------- TAB BAR ------------->
    <div class="tab-bar">
      {%if stinger.signals %}
      <button class="tab-btn" ng-class="{'active': activeTab === 'signals'}" ng-click="activeTab = 'signals'">
        <span class="mdi mdi-bell-outline"></span> Signals
      </button>
      {%endif%}
      {%if stinger.properties %}
      <button class="tab-btn" ng-class="{'active': activeTab === 'properties'}" ng-click="activeTab = 'properties'">
        <span class="mdi mdi-tune"></span> Properties
      </button>
      {%endif%}
      {%if stinger.methods %}
      <button class="tab-btn" ng-class="{'active': activeTab === 'methods'}" ng-click="activeTab = 'methods'">
        <span class="mdi mdi-function"></span> Methods
      </button>
      {%endif%}
      {%if stinger.commands %}
      <button class="tab-btn" ng-class="{'active': activeTab === 'commands'}" ng-click="activeTab = 'commands'">
        <span class="mdi mdi-send"></span> Commands
      </button>
      {%endif%}
    </div>

    <!------------- SIGNALS ------------->
    <div ng-show="activeTab === 'signals'">
    {%for sig_name, sig in stinger.signals.items() %}
    <div class="component-box signal-box{% if sig.payload.is_protobuf %} protobuf-box{% endif %}" id="signal-box-{{ sig_name }}">
        <h3 class="component-title signal-title" ng-class="{'flash': signals['{{ sig_name | lowerCamelCase }}'].flash}"><span class="mdi mdi-bell-outline"></span> {{ sig_name }}</h3>
        {%if sig.documentation %}
        <details class="component-doc signal-doc">
          <summary>Documentation</summary>
{%markdown%}
{{ sig.documentation }}
{%endmarkdown%}
        </details>
        {%endif%}
        <!--<div class="signal-topic topic">Subscribe: {{ sig.topic() }}</div>-->
{%- if sig.payload.is_protobuf %}
        <div class="protobuf-note">protobuf <code>{{ sig.payload.protobuf.full_name }}</code>, published as <code>{{ codec.content_type(sig.payload) }}</code></div>
{%- endif %}
        <div class="last-received signal-value">
{%- if sig.payload.is_protobuf %}
        {{ codec.protoform(sig.payload, "signals['" + (sig_name | lowerCamelCase) + "'].received", true) | indent(8) }}
{%- else %}
        {{ arglist(sig.arg_list, ['signals', sig_name, 'received'], true) | indent(8) }}
{%- endif %}
        </div>
        <div class="proto-error" ng-show="signals['{{ sig_name | lowerCamelCase }}'].decode_error" ng-bind="signals['{{ sig_name | lowerCamelCase }}'].decode_error"></div>
    </div>
    {%endfor%}{# end signals loop #}
    </div>

    <!------------- PROPERTIES ------------->
    <div ng-show="activeTab === 'properties'">
    {%for prop_name, prop in stinger.properties.items() %}
    <div class="component-box prop-box{% if prop.payload.is_protobuf %} protobuf-box{% endif %}" id="prop-box-{{ prop_name }}">
        <h3 class="component-title prop-title" ng-class="{'flash': properties['{{ prop_name | lowerCamelCase }}'].flash}"><span class="mdi mdi-tune"></span> {{ prop_name }}</h3>
        {%if prop.documentation %}
        <details class="component-doc prop-doc">
          <summary>Documentation</summary>
{%markdown%}
{{ prop.documentation }}
{%endmarkdown%}
        </details>
        {%endif%}
        <!--<div class="property-topic topic">Subscribe: {{ prop.value_topic() }}</div>-->
{%- if prop.payload.is_protobuf %}
        <div class="protobuf-note">protobuf <code>{{ prop.payload.protobuf.full_name }}</code>, published as <code>{{ codec.content_type(prop.payload) }}</code></div>
{%- endif %}
        <div class="last-received property-value">
{%- if prop.payload.is_protobuf %}
          {{ codec.protoform(prop.payload, "properties['" + (prop_name | lowerCamelCase) + "'].received", prop.read_only) | indent(10) }}
{%- else %}
          {{ arglist(prop.arg_list, ['properties', prop_name, 'received'], prop.read_only) | indent(10) }}
{%- endif %}
        </div>
        <div class="proto-error" ng-show="properties['{{ prop_name | lowerCamelCase }}'].decode_error" ng-bind="properties['{{ prop_name | lowerCamelCase }}'].decode_error"></div>
        {%if not prop.read_only %}
        <input type="button" class="publish-button" value="Update" ng-click="updateProperty(properties.{{ prop_name | lowerCamelCase }})" />
        <div class="proto-error" ng-show="properties['{{ prop_name | lowerCamelCase }}'].encode_error" ng-bind="properties['{{ prop_name | lowerCamelCase }}'].encode_error"></div>
        {%endif%}
    </div>
    {%endfor%} {# end properties loop #}
    </div>

    <!------------- METHODS ------------->
    <div ng-show="activeTab === 'methods'">
    {%for method_name, method in stinger.methods.items() %}
    <div class="component-box method-box{% if method.request_payload.is_protobuf or method.response_payload.is_protobuf %} protobuf-box{% endif %}" id="method-box-{{ method_name }}">
        <h3 class="component-title method-title"><span class="mdi mdi-function"></span> {{ method_name }}</h3>
        {%if method.documentation %}
        <details class="component-doc method-doc">
          <summary>Documentation</summary>
{%markdown%}
{{ method.documentation }}
{%endmarkdown%}
        </details>
        {%endif%}
        <!--<div class="method-topic topic">Publish: {{ method.topic }}</div>-->
        <div class="method-form-box">
{%- if method.request_payload.is_protobuf %}
            <div class="protobuf-note">Request: protobuf <code>{{ method.request_payload.protobuf.full_name }}</code></div>
{%- endif %}
            <form ng-submit="callMethod(methods.{{method_name|lowerCamelCase}})">
{%- if method.request_payload.is_protobuf %}
                {{ codec.protoform(method.request_payload, "methods['" + (method_name | lowerCamelCase) + "'].args", false) | indent(16) }}
{%- else %}
                {{ arglist(method.arg_list, ['methods', method_name, 'args'], false) | indent(8) }}
{%- endif %}
                <button type="submit" class="publish-button">Call {{ method_name }}</button>
            </form>
            <div class="proto-error" ng-show="methods['{{ method_name | lowerCamelCase }}'].encode_error" ng-bind="methods['{{ method_name | lowerCamelCase }}'].encode_error"></div>
        </div>
        <div class="last-received method-response" ng-show="methods['{{ method_name | lowerCamelCase }}'].received_time || methods['{{ method_name | lowerCamelCase }}'].decode_error">
            <div class="method-response-status" ng-show="methods['{{ method_name | lowerCamelCase }}'].received_time"><span class="mdi mdi-check-circle-outline"></span> Response received at <span ng-bind="methods['{{ method_name | lowerCamelCase }}'].received_time | date:'HH:mm:ss'"></span></div>
        {#- A method's two wire bodies are independent: either may be protobuf
            while the other is JSON, so the response is asked about separately. #}
        {%- if method.response_payload.is_protobuf %}
        <div class="protobuf-note">Response: protobuf <code>{{ method.response_payload.protobuf.full_name }}</code></div>
        {{ codec.protoform(method.response_payload, "methods['" + (method_name | lowerCamelCase) + "'].received", true) | indent(8) }}
        {%- elif method.return_value is not none %}
        {{ arglist(method.return_arg_list, ['methods', method_name, 'received'], true) | indent(8) }}
        {%- endif %}
            <div class="proto-error" ng-show="methods['{{ method_name | lowerCamelCase }}'].decode_error" ng-bind="methods['{{ method_name | lowerCamelCase }}'].decode_error"></div>
        </div>
    </div>
    {%endfor%} {# end methods loop #}
    </div>

    <!------------- COMMANDS ------------->
    <div ng-show="activeTab === 'commands'">
    {%for command_name, command in stinger.commands.items() %}
    <div class="component-box command-box{% if command.payload.is_protobuf %} protobuf-box{% endif %}" id="command-box-{{ command_name }}">
        <h3 class="component-title command-title"><span class="mdi mdi-send"></span> {{ command_name }}</h3>
        {%if command.documentation %}
        <details class="component-doc command-doc">
          <summary>Documentation</summary>
{%markdown%}
{{ command.documentation }}
{%endmarkdown%}
        </details>
        {%endif%}
        <!--<div class="command-topic topic">Publish: {{ command.topic() }}</div>-->
        <div class="command-form-box">
{%- if command.payload.is_protobuf %}
            <div class="protobuf-note">protobuf <code>{{ command.payload.protobuf.full_name }}</code>, published as <code>{{ codec.content_type(command.payload) }}</code></div>
{%- endif %}
            <form ng-submit="sendCommand(commands.{{command_name|lowerCamelCase}})">
{%- if command.payload.is_protobuf %}
                {{ codec.protoform(command.payload, "commands['" + (command_name | lowerCamelCase) + "'].args", false) | indent(16) }}
{%- else %}
                {{ arglist(command.arg_list, ['commands', command_name, 'args'], false) | indent(8) }}
{%- endif %}
                <button type="submit" class="publish-button">Send {{ command_name }}</button>
            </form>
            <div class="proto-error" ng-show="commands['{{ command_name | lowerCamelCase }}'].encode_error" ng-bind="commands['{{ command_name | lowerCamelCase }}'].encode_error"></div>
        </div>
        <div class="command-sent-status" ng-show="commands['{{ command_name | lowerCamelCase }}'].sent_time">
            <span class="mdi mdi-send-check-outline"></span> Sent at <span ng-bind="commands['{{ command_name | lowerCamelCase }}'].sent_time | date:'HH:mm:ss'"></span>.  A command is fire-and-forget, so there is no response.
        </div>
    </div>
    {%endfor%} {# end commands loop #}
    </div>

{{ codec.field_list_template(stinger) }}

    {%raw%}
    <div id="console" ng-class="{ 'expanded' : (console.showing) }">
      <div class="top" ng-click=" console.showing = !console.showing ">Request Console <span ng-show="console.showing && console.requests.length > 0" ng-click="console.requests = []"> - Clear</span>
        <p class="expanded-toggle">{{ console.showing ? 'Hide' : 'Show' }}</p>
      </div>
      <div id="request-list">
        <p ng-repeat="msg in console.requests" class="entry">
          <strong>{{msg.name}}:</strong> <em>{{msg.topic}}</em> <span class="elapsedTime" ng-show="msg.responseTime">{{msg.responseTime - msg.requestTime}}ms</span><span class="elapsedTime" ng-show="msg.eventTime">{{msg.eventTime}}</span>
          <span class="outgoing" ng-show="msg.payload">{{msg.payload}}</span>
          <span class="incoming" ng-show="msg.responseTime">{{ (msg.response === null || msg.response === undefined) ? '(empty response)' : msg.response }}</span>
          <span ng-repeat="result in msg.results" class="action-result">{{result}}</span>
        </p>
      </div>
    </div>
    {%endraw%}

    <script src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.8.2/angular.min.js"></script>
    <script src="https://unpkg.com/mqtt@5.14.0/dist/mqtt.min.js"></script>
{%- if stinger.uses_protobuf() %}
    <!-- long.js must load before protobuf.js.  protobuf.js reads `window.Long`
         at load time and its own fallback is written to defeat bundlers, so the
         CDN build carries no copy.  Without it a 64-bit field is silently
         rounded through a JavaScript number and `{longs: String}` does nothing. -->
    <script src="https://cdn.jsdelivr.net/npm/long@5.2.3/umd/index.js"></script>
    <!-- The light build: everything needed to load a JSON descriptor and read
         and write messages.  The full build adds a .proto text parser, which
         this page has no use for -- its schema arrives already parsed. -->
    <script src="https://cdn.jsdelivr.net/npm/protobufjs@7.4.0/dist/light/protobuf.min.js"></script>
    <script src="proto_bundle.js"></script>
{%- endif %}
    <script src="app.js"></script>
  </body>
</html>