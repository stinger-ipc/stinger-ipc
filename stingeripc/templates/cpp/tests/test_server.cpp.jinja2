    const std::string payload = Wire<{{command.payload.cpp.class_name}}>::ToString(commandPayload);
{%- else %}

    {%if command.arg_list | length > 0 %}
    {{command.cpp.payload_struct_name}} commandPayload{ {%for arg in command.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string payload = serializeToString(commandPayload);
    {%else%}
    const std::string payload = "{}";
    {%endif%}
{%- endif %}

    const std::string commandTopic = stinger::utils::format("{{command.topic()}}", topicArgs());
    // Commands are published without a response topic or correlation data.
    stinger::mqtt::Properties commandProperties;
    commandProperties.contentType = "{{ codec.content_type(command.payload) }}";
    auto msg = stinger::mqtt::Message(commandTopic, payload, {{stinger.command_qos}}, false, commandProperties);

    _conn->ClearPublishedMessages();
    _conn->SimulateIncomingMessage(msg);

    EXPECT_TRUE(*handlerCalled);
    // Commands have no response channel, so the server must not publish anything back.
    EXPECT_EQ(_conn->GetPublishedMessages(commandTopic).size(), 0u);
}
