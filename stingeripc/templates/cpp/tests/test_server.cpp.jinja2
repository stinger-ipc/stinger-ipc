// A simulated `{{prop_name}}` update request should be applied and re-published as the new value.
TEST_F({{stinger.cpp.server_class_name}}Test, {{prop_name | UpperCamelCase}}UpdateRequestIsRepublished)
{
    const std::string updateTopic = stinger::utils::format("{{prop.update_topic()}}", topicArgs());
    const std::string valueTopic = stinger::utils::format("{{prop.value_topic()}}", topicArgs());

{%- if config.properties.version_tracking %}
    // A request carries the version the client last saw, and the server rejects one that
    // does not match.  One server is shared by every test in this suite, so the property's
    // version is wherever earlier tests left it: give the property a value, then read the
    // version back off the value message rather than assuming this is its first.
    _conn->ClearPublishedMessages();
    _server->update{{prop.name | UpperCamelCase}}Property({{pr.example_value(prop)}});
    const auto valueMessages = _conn->GetPublishedMessages(valueTopic);
    ASSERT_FALSE(valueMessages.empty()) << "Updating '{{prop_name}}' published no value message to read a version from";
    ASSERT_TRUE(valueMessages.back().properties.propertyVersion.has_value()) << "The published '{{prop_name}}' value carries no version";
    const int currentVersion = *valueMessages.back().properties.propertyVersion;
{%- endif %}

    {{prop.payload.cpp.class_name}} newValue{ {%for arg in prop.arg_list%}{{arg.get_random_example_value(lang="c++", seed=99)}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string payload = serializeToString(newValue);
    const std::vector<std::byte> correlationData{ std::byte{0x01} };
    auto msg = stinger::mqtt::Message::PropertyUpdateRequest(updateTopic, payload, {%if config.properties.version_tracking%}currentVersion{%else%}std::nullopt{%endif%}, correlationData, "test/response");
    msg.properties.contentType = "{{ codec.content_type(prop.payload) }}";

    _conn->ClearPublishedMessages();
    _conn->SimulateIncomingMessage(msg);

    EXPECT_EQ(_conn->GetPublishedMessages(valueTopic).size(), 1u);

    // The client that sent the request is waiting on the response topic it named.
    auto responses = _conn->GetPublishedMessages("test/response");
    ASSERT_EQ(responses.size(), 1u) << "No update response was published for '{{prop_name}}'";
    ASSERT_TRUE(responses[0].properties.returnCode.has_value());
    EXPECT_EQ(*responses[0].properties.returnCode, static_cast<int>(stinger::error::MethodReturnCode::SUCCESS));
    EXPECT_EQ(responses[0].properties.correlationData, correlationData);
    EXPECT_EQ(responses[0].payload, serializeToString(newValue)) << "The response should carry the property's new value";
}
{%- if config.properties.version_tracking %}

// An update request carrying a version the server has moved past is rejected, and the
// rejection is reported on the response topic rather than silently dropped.
TEST_F({{stinger.cpp.server_class_name}}Test, {{prop_name | UpperCamelCase}}UpdateRequestWithStaleVersionIsRejected)
{
    const std::string updateTopic = stinger::utils::format("{{prop.update_topic()}}", topicArgs());
    const std::string valueTopic = stinger::utils::format("{{prop.value_topic()}}", topicArgs());

    _conn->ClearPublishedMessages();
    _server->update{{prop.name | UpperCamelCase}}Property({{pr.example_value(prop)}});
    const auto valueMessages = _conn->GetPublishedMessages(valueTopic);
    ASSERT_FALSE(valueMessages.empty()) << "Updating '{{prop_name}}' published no value message to read a version from";
    const int currentVersion = valueMessages.back().properties.propertyVersion.value_or({{ pr.first_property_version() }});

    {{prop.payload.cpp.class_name}} newValue{ {%for arg in prop.arg_list%}{{arg.get_random_example_value(lang="c++", seed=99)}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::vector<std::byte> correlationData{ std::byte{0x02} };
    auto msg = stinger::mqtt::Message::PropertyUpdateRequest(updateTopic, serializeToString(newValue), currentVersion - 1, correlationData, "test/response");
    msg.properties.contentType = "{{ codec.content_type(prop.payload) }}";

    _conn->ClearPublishedMessages();
    _conn->SimulateIncomingMessage(msg);

    EXPECT_EQ(_conn->GetPublishedMessages(valueTopic).size(), 0u) << "A stale update should not change the property";

    auto responses = _conn->GetPublishedMessages("test/response");
    ASSERT_EQ(responses.size(), 1u) << "A rejected update was not reported to the client";
    ASSERT_TRUE(responses[0].properties.returnCode.has_value());
    EXPECT_EQ(*responses[0].properties.returnCode, static_cast<int>(stinger::error::MethodReturnCode::OUT_OF_SYNC));
    EXPECT_TRUE(responses[0].properties.debugInfo.has_value()) << "A rejection should say why";
}
{%- endif %}
{%endif%}
{%- endif %}
