// A simulated `{{method_name}}` request should invoke the registered handler and publish a response.
TEST_F({{stinger.cpp.server_class_name}}Test, {{method_name | UpperCamelCase}}RequestInvokesHandler)
{
    // Captured by value (shared_ptr) so the registered handler stays valid for the
    // lifetime of the shared server, even after this test returns.
    auto handlerCalled = std::make_shared<bool>(false);
    _server->register{{method_name | UpperCamelCase}}Handler([handlerCalled]({%for arg in method.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%}) -> {{method.cpp.return_value_class}}
    {
        *handlerCalled = true;
        {%-if method.has_response %}
        return {{ codec.example_return(method) }};
        {%-endif%}
    });

    {%if method.arg_list | length > 0 %}
    {{method.request_payload.cpp.class_name}} requestArgs{ {%for arg in method.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string payload = serializeToString(requestArgs);
    {%else%}
    const std::string payload = "{}";
    {%endif%}

    const std::string requestTopic = stinger::utils::format("{{method.request_topic()}}", topicArgs());
    const std::string responseTopic = stinger::utils::format("{{method.response_topic()}}", topicArgs());
    const std::vector<std::byte> correlationData{ std::byte{0x01}, std::byte{0x02} };
    auto msg = stinger::mqtt::Message::MethodRequest(requestTopic, payload, correlationData, responseTopic);

    _conn->ClearPublishedMessages();
    _conn->SimulateIncomingMessage(msg);

    // The server publishes a response (success or error) to the response topic.
    EXPECT_TRUE(waitFor([&] { return _conn->GetPublishedMessages(responseTopic).size() == 1u; }))
            << "No response was published for '{{method_name}}'";
    EXPECT_TRUE(*handlerCalled);
}

// A `{{method_name}}` handler must not run on the thread that delivered the request.
// The application's handler is arbitrarily slow, and running it inline would stall the
// broker's network loop: no keep-alives, no other subscriptions, no outgoing publishes
// for as long as the handler takes.
TEST_F({{stinger.cpp.server_class_name}}Test, {{method_name | UpperCamelCase}}RequestDoesNotBlockDeliveringThread)
{
    // Captured by value (shared_ptr) so they stay valid for the lifetime of the shared
    // server, even after this test returns.
    auto handlerEntered = std::make_shared<std::atomic<bool>>(false);
    auto releaseHandler = std::make_shared<std::atomic<bool>>(false);

    _server->register{{method_name | UpperCamelCase}}Handler([handlerEntered, releaseHandler]({%for arg in method.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%}) -> {{method.cpp.return_value_class}}
    {
        handlerEntered->store(true);
        // Block until the test releases it, but give up eventually so that a regression
        // to inline handling fails this test rather than hanging the suite.
        const auto giveUp = std::chrono::steady_clock::now() + std::chrono::seconds(5);
        while (!releaseHandler->load() && std::chrono::steady_clock::now() < giveUp)
        {
            std::this_thread::sleep_for(std::chrono::milliseconds(1));
        }
        {%-if method.has_response %}
        return {{ codec.example_return(method) }};
        {%-endif%}
    });

    {%if method.arg_list | length > 0 %}
    {{method.request_payload.cpp.class_name}} slowRequestArgs{ {%for arg in method.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string payload = serializeToString(slowRequestArgs);
    {%else%}
    const std::string payload = "{}";
    {%endif%}

    const std::string requestTopic = stinger::utils::format("{{method.request_topic()}}", topicArgs());
    const std::string responseTopic = stinger::utils::format("{{method.response_topic()}}", topicArgs());
    const std::vector<std::byte> correlationData{ std::byte{0x01} };
    auto msg = stinger::mqtt::Message::MethodRequest(requestTopic, payload, correlationData, responseTopic);

    _conn->ClearPublishedMessages();

    // Delivering the request must hand control straight back, not wait for the handler.
    const auto deliveryStart = std::chrono::steady_clock::now();
    _conn->SimulateIncomingMessage(msg);
    const auto deliveryDuration = std::chrono::steady_clock::now() - deliveryStart;

    ASSERT_TRUE(waitFor([&] { return handlerEntered->load(); }))
            << "The '{{method_name}}' handler was never called";
    EXPECT_LT(deliveryDuration, std::chrono::milliseconds(500))
            << "Delivering the '{{method_name}}' request waited on the handler";

    // The handler is still blocked, so it cannot have responded yet.
    EXPECT_TRUE(_conn->GetPublishedMessages(responseTopic).empty())
            << "A '{{method_name}}' response was published before the handler returned";

    releaseHandler->store(true);
    EXPECT_TRUE(waitFor([&] { return _conn->GetPublishedMessages(responseTopic).size() == 1u; }))
            << "No '{{method_name}}' response was published after the handler returned";
}
{%- endif %}
{%endfor%}

