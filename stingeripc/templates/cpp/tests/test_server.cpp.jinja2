// The server handles method requests on its own dispatch thread rather than on the
// thread that delivered the message, so a test has to wait for the handling to land
// instead of asserting immediately after simulating a request.
bool waitFor(const std::function<bool()>& pred,
             std::chrono::milliseconds timeout = std::chrono::milliseconds(2000))
{
    const auto deadline = std::chrono::steady_clock::now() + timeout;
    while (std::chrono::steady_clock::now() < deadline)
    {
        if (pred())
        {
            return true;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    return pred();
}
{%endif%}

// Serializes a generated payload/struct (anything exposing AddToRapidJsonObject)
// to a compact JSON string.
template <typename T>
std::string serializeToString(const T& obj)
{
    rapidjson::Document doc;
    doc.SetObject();
    obj.AddToRapidJsonObject(doc, doc.GetAllocator());
    rapidjson::StringBuffer buf;
    rapidjson::Writer<rapidjson::StringBuffer> writer(buf);
    doc.Accept(writer);
    return buf.GetString();
}

// The server starts a service-advertisement thread in its constructor; tearing it
// down joins that thread, which can take up to a second.  To keep the suite fast,
// the server is constructed once per suite and shared across tests.  Each test
// clears the broker's published-message log so assertions stay isolated.
class {{stinger.cpp.server_class_name}}Test : public ::testing::Test
{
protected:
    static std::shared_ptr<stinger::utils::MockConnection> _conn;
    static std::unique_ptr<{{stinger.cpp.server_class_name}}> _server;

    static void SetUpTestSuite()
    {
        _conn = std::make_shared<stinger::utils::MockConnection>(kClientId);
        _server = std::make_unique<{{stinger.cpp.server_class_name}}>(_conn, kServiceId{%for topic_param in stinger.topics.params %}, "test-{{topic_param}}"{%endfor%});
    }

    static void TearDownTestSuite()
    {
        // Destroy the server (stops its advertisement thread) before the connection.
        _server.reset();
        _conn.reset();
    }

    void SetUp() override
    {
        _conn->ClearPublishedMessages();
    }

    // Mirrors the topic parameters the server uses internally so tests can
    // reconstruct the exact concrete topic strings.
    static std::map<std::string, std::string> topicArgs()
    {
        std::map<std::string, std::string> params;
        params["service_id"] = kServiceId;
        params["interface_name"] = {{stinger.cpp.server_class_name}}::NAME;
        params["client_id"] = _conn->GetClientId();
        {%-for topic_param in stinger.topics.params %}
        params["{{topic_param}}"] = "test-{{topic_param}}";
        {%-endfor%}
        return params;
    }
};

std::shared_ptr<stinger::utils::MockConnection> {{stinger.cpp.server_class_name}}Test::_conn;
std::unique_ptr<{{stinger.cpp.server_class_name}}> {{stinger.cpp.server_class_name}}Test::_server;

} // anonymous namespace

// The server should subscribe to one topic per method request, per command, and per property update.
TEST_F({{stinger.cpp.server_class_name}}Test, SubscribesToExpectedTopics)
{
    const std::size_t expected = {{ stinger.methods|length + stinger.commands|length + stinger.properties|length }};
    EXPECT_EQ(_conn->GetSubscriptions().size(), expected);

    {%-for method_name, method in stinger.methods.items() %}
    EXPECT_TRUE(_conn->IsSubscribed(stinger::utils::format("{{method.request_topic()}}", topicArgs()))) << "Not subscribed to {{method_name}} request topic";
    {%-endfor%}
    {%-for command_name, command in stinger.commands.items() %}
    EXPECT_TRUE(_conn->IsSubscribed(stinger::utils::format("{{command.topic()}}", topicArgs()))) << "Not subscribed to {{command_name}} command topic";
    {%-endfor%}
    {%-for prop_name, prop in stinger.properties.items() %}
    EXPECT_TRUE(_conn->IsSubscribed(stinger::utils::format("{{prop.update_topic()}}", topicArgs()))) << "Not subscribed to {{prop_name}} update topic";
    {%-endfor%}
}

