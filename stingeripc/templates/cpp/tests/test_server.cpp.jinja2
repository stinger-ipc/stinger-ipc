    // lifetime of the shared server, even after this test returns.
    auto handlerCalled = std::make_shared<bool>(false);
    _server->receive{{command_name | UpperCamelCase}}Command([handlerCalled]({{ pl.param_types(command.payload) }})
    {
        *handlerCalled = true;
    });
{%- if command.payload.is_protobuf %}

