namespace {

// Values used to construct the client's InstanceInfo and to reconstruct the
// concrete topics the client subscribes/publishes to.
constexpr const char* kClientId = "test-client";
constexpr const char* kServiceId = "test-service";

// Serializes a generated payload/struct (anything exposing AddToRapidJsonObject)
// to a compact JSON string.
template <typename T>
std::string serializeToString(const T& obj)
{
    rapidjson::Document doc;
    doc.SetObject();
    obj.AddToRapidJsonObject(doc, doc.GetAllocator());
    rapidjson::StringBuffer buf;
    rapidjson::Writer<rapidjson::StringBuffer> writer(buf);
    doc.Accept(writer);
    return buf.GetString();
}

class {{stinger.cpp.client_class_name}}Test : public ::testing::Test
{
protected:
    std::shared_ptr<stinger::utils::MockConnection> _conn;
    std::unique_ptr<{{stinger.cpp.client_class_name}}> _client;

    void SetUp() override
    {
        _conn = std::make_shared<stinger::utils::MockConnection>(kClientId);

        InstanceInfo info;
        info.serviceId = kServiceId;
        {%-for topic_param in config.topics.params %}
        info.{{topic_param|lowerCamelCase}} = "test-{{topic_param}}";
        {%-endfor%}

        _client = std::make_unique<{{stinger.cpp.client_class_name}}>(_conn, info);
    }

    // Mirrors the topic parameters the client uses internally so tests can
    // reconstruct the exact concrete topic strings.
    std::map<std::string, std::string> topicParams() const
    {
        std::map<std::string, std::string> params;
        params["client_id"] = _conn->GetClientId();
        params["service_id"] = kServiceId;
        params["interface_name"] = {{stinger.cpp.client_class_name}}::NAME;
        {%-for topic_param in config.topics.params %}
        params["{{topic_param}}"] = "test-{{topic_param}}";
        {%-endfor%}
        return params;
    }
};

} // anonymous namespace

// The client should subscribe to one topic per method response{% if stinger.properties | length > 0 %}, plus the aggregate
// property-update response topic{% endif %}.  Signal{% if stinger.properties | length > 0 %} and property value{% endif %} topics are not among them:
// those are subscribed to on first use.
TEST_F({{stinger.cpp.client_class_name}}Test, SubscribesToExpectedTopics)
{
    const std::size_t expected = {{ stinger.methods|length + (1 if stinger.properties|length > 0 else 0) }};
    EXPECT_EQ(_conn->GetSubscriptions().size(), expected);

    {%-for sig_name, sig in stinger.signals.items() %}
    EXPECT_FALSE(_conn->IsSubscribed(stinger::utils::format("{{sig.topic()}}", topicParams()))) << "Subscribed to the {{sig_name}} signal topic before a callback was registered";
    {%-endfor%}
    {%-for method_name, method in stinger.methods.items() %}
    EXPECT_TRUE(_conn->IsSubscribed(stinger::utils::format("{{method.response_topic()}}", topicParams()))) << "Not subscribed to {{method_name}} response topic";
    {%-endfor%}
    {%-for prop_name, prop in stinger.properties.items() %}
    EXPECT_FALSE(_conn->IsSubscribed(stinger::utils::format("{{prop.value_topic()}}", topicParams()))) << "Subscribed to the {{prop_name}} property value topic before the application asked for it";
    {%-endfor%}
}

{%for sig_name, sig in stinger.signals.items()%}
// Registering a `{{sig_name}}` callback is what subscribes the client to the signal.
TEST_F({{stinger.cpp.client_class_name}}Test, {{sig_name | UpperCamelCase}}CallbackSubscribesToSignal)
{
    const std::string signalTopic = stinger::utils::format("{{sig.topic()}}", topicParams());
    ASSERT_FALSE(_conn->IsSubscribed(signalTopic));

    _client->register{{sig_name | UpperCamelCase}}Callback([]({{ar.declarationParams(sig.arg_list)}}) {});

    EXPECT_TRUE(_conn->IsSubscribed(signalTopic)) << "Registering a {{sig_name}} callback did not subscribe to the signal";

    // A second callback reuses the one subscription.
    const std::size_t subscriptionCount = _conn->GetSubscriptions().size();
    _client->register{{sig_name | UpperCamelCase}}Callback([]({{ar.declarationParams(sig.arg_list)}}) {});
    EXPECT_EQ(_conn->GetSubscriptions().size(), subscriptionCount) << "Registering a second {{sig_name}} callback subscribed again";
}

{%- if not sig.payload.is_protobuf %}{#- a protobuf payload has no example field values to round-trip yet #}
// A simulated incoming `{{sig_name}}` signal should be dispatched to the registered callback.
TEST_F({{stinger.cpp.client_class_name}}Test, {{sig_name | UpperCamelCase}}SignalInvokesCallback)
{
    bool callbackInvoked = false;
    _client->register{{sig_name | UpperCamelCase}}Callback([&callbackInvoked]({%for arg in sig.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%})
    {
        callbackInvoked = true;
    });

    {{sig.payload.cpp.class_name}} payload{ {%for arg in sig.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string topic = stinger::utils::format("{{sig.topic()}}", topicParams());
    // The MockConnection routes the message by topic and stamps the matching
    // subscription id, which is how the client dispatches it to the callback.
    auto msg = stinger::mqtt::Message::Signal(topic, serializeToString(payload));

    _conn->SimulateIncomingMessage(msg);

    EXPECT_TRUE(callbackInvoked);
}
{%- endif %}
{%endfor%}

{%for method_name, method in stinger.methods.items()%}
{%- if not method.request_payload.is_protobuf %}{#- a protobuf payload has no example field values to round-trip yet #}
// Calling `{{method_name}}` should publish a request to the broker.
TEST_F({{stinger.cpp.client_class_name}}Test, {{method_name | UpperCamelCase}}PublishesRequest)
{
    _conn->ClearPublishedMessages();

    auto pending = _client->{{method_name | camelCase}}({%for arg in method.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%});

    auto published = _conn->GetPublishedMessages();
    ASSERT_EQ(published.size(), 1u);
    EXPECT_EQ(published[0].topic, stinger::utils::format("{{method.request_topic()}}", topicParams()));

    rapidjson::Document doc;
    EXPECT_FALSE(doc.Parse(published[0].payload.c_str()).HasParseError()) << "Published request payload is not valid JSON";
    EXPECT_TRUE(doc.IsObject());
}
{%- endif %}
{%endfor%}

{%for prop_name, prop in stinger.properties.items()%}
// Registering a `{{prop_name}}` callback is what subscribes the client to the property.
TEST_F({{stinger.cpp.client_class_name}}Test, {{prop_name | UpperCamelCase}}CallbackSubscribesToProperty)
{
    const std::string valueTopic = stinger::utils::format("{{prop.value_topic()}}", topicParams());
    ASSERT_FALSE(_conn->IsSubscribed(valueTopic));

    _client->register{{prop_name | UpperCamelCase}}PropertyCallback([]({{ar.declarationParams(prop.arg_list)}}) {});

    EXPECT_TRUE(_conn->IsSubscribed(valueTopic)) << "Registering a {{prop_name}} callback did not subscribe to the property";

    // A second callback reuses the one subscription.
    const std::size_t subscriptionCount = _conn->GetSubscriptions().size();
    _client->register{{prop_name | UpperCamelCase}}PropertyCallback([]({{ar.declarationParams(prop.arg_list)}}) {});
    EXPECT_EQ(_conn->GetSubscriptions().size(), subscriptionCount) << "Registering a second {{prop_name}} callback subscribed again";
}

{%- if not prop.payload.is_protobuf %}{#- a protobuf property has no example field values to round-trip #}
// The `{{prop_name}}` getter returns the value the server published.
TEST_F({{stinger.cpp.client_class_name}}Test, {{prop_name | UpperCamelCase}}GetterReturnsReceivedValue)
{
    // The getter blocks until a value arrives, so subscribe first (by registering a
    // callback), deliver the value, and only then read it.
    _client->register{{prop_name | UpperCamelCase}}PropertyCallback([]({{ar.declarationParams(prop.arg_list)}}) {});

    {{prop.payload.cpp.class_name}} currentValue{ {%for arg in prop.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string valueTopic = stinger::utils::format("{{prop.value_topic()}}", topicParams());
    _conn->SimulateIncomingMessage(stinger::mqtt::Message::PropertyValue(valueTopic, serializeToString(currentValue), {%if config.properties.version_tracking%}3{%else%}std::nullopt{%endif%}));

    EXPECT_NO_THROW(_client->get{{prop_name | UpperCamelCase}}Property());
}
{%-if not prop.read_only %}

// Updating `{{prop_name}}` should publish an update request to the broker.
TEST_F({{stinger.cpp.client_class_name}}Test, {{prop_name | UpperCamelCase}}UpdatePublishesRequest)
{
{%- if config.properties.version_tracking %}
    // An update request carries the version of the value this client last saw, so the
    // property has to have been received before it can be updated.
{%- else %}
    // An update request is only sent once the property's current value is known, so the
    // property has to have been received before it can be updated.
{%- endif %}
    _client->register{{prop_name | UpperCamelCase}}PropertyCallback([]({{ar.declarationParams(prop.arg_list)}}) {});
    {{prop.payload.cpp.class_name}} currentValue{ {%for arg in prop.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%} };
    const std::string valueTopic = stinger::utils::format("{{prop.value_topic()}}", topicParams());
    _conn->SimulateIncomingMessage(stinger::mqtt::Message::PropertyValue(valueTopic, serializeToString(currentValue), {%if config.properties.version_tracking%}3{%else%}std::nullopt{%endif%}));

    _conn->ClearPublishedMessages();

    auto pending = _client->update{{prop.name | UpperCamelCase}}Property({%for arg in prop.arg_list%}{{arg.get_random_example_value(lang="c++")}}{%if not loop.last%}, {%endif%}{%endfor%});

    auto published = _conn->GetPublishedMessages();
    ASSERT_EQ(published.size(), 1u);
    EXPECT_EQ(published[0].topic, stinger::utils::format("{{prop.update_topic()}}", topicParams()));

    rapidjson::Document doc;
    EXPECT_FALSE(doc.Parse(published[0].payload.c_str()).HasParseError()) << "Published property update payload is not valid JSON";
    EXPECT_TRUE(doc.IsObject());
}
{%endif%}
{%- endif %}
{%endfor%}

{%for command_name, command in stinger.commands.items()%}
{%- if not command.payload.is_protobuf %}{#- a protobuf payload has no example field values to round-trip yet #}
// Sending `{{command_name}}` should publish the command to the broker.
TEST_F({{stinger.cpp.client_class_name}}Test, {{command_name | UpperCamelCase}}CommandPublishes)
{
    _conn->ClearPublishedMessages();
    {%-for arg in command.arg_list%}{%if arg.arg_type.name.lower() == 'struct'%}
    {{arg.cpp.type}} {{arg.name|lowerCamelCase}}Arg = {{arg.get_random_example_value(lang="c++")}};
    {%-endif%}{%endfor%}

    _client->send{{command_name | UpperCamelCase}}Command({%for arg in command.arg_list%}{%if arg.arg_type.name.lower() == 'struct'%}{{arg.name|lowerCamelCase}}Arg{%else%}{{arg.get_random_example_value(lang="c++")}}{%endif%}{%if not loop.last%}, {%endif%}{%endfor%});

    auto published = _conn->GetPublishedMessages();
    ASSERT_EQ(published.size(), 1u);
    EXPECT_EQ(published[0].topic, stinger::utils::format("{{command.topic()}}", topicParams()));
    // Commands are fire-and-forget, so they carry no response topic and no correlation data.
    EXPECT_FALSE(published[0].properties.responseTopic.has_value());
    EXPECT_FALSE(published[0].properties.correlationData.has_value());

    rapidjson::Document doc;
    EXPECT_FALSE(doc.Parse(published[0].payload.c_str()).HasParseError()) << "Published command payload is not valid JSON";
    EXPECT_TRUE(doc.IsObject());
}
{%- endif %}
{%endfor%}
