/// How one payload type crosses the wire.
///
/// Every generated payload has a specialization below, so the client and server
/// serialize and deserialize through one call rather than repeating the encoding
/// at each publish and receive site.  A payload described by JSON arguments is
/// carried as JSON; a payload declared as a protobuf message is carried as that
/// message's own encoding.
template <class T>
struct Wire;

{%- macro json_wire(type_name) %}

template <>
struct Wire<{{type_name}}> {
    static constexpr const char* kContentType = "application/json";

    static std::string ToString(const {{type_name}}& value)
    {
        rapidjson::Document doc;
        doc.SetObject();
        value.AddToRapidJsonObject(doc, doc.GetAllocator());
        rapidjson::StringBuffer buf;
        rapidjson::Writer<rapidjson::StringBuffer> writer(buf);
        doc.Accept(writer);
        return buf.GetString();
    }

    static {{type_name}} FromString(const std::string& payload)
    {
        rapidjson::Document doc;
        rapidjson::ParseResult ok = doc.Parse(payload.c_str());
        if (!ok)
        {
            throw std::runtime_error(rapidjson::GetParseError_En(ok.Code()));
        }
        if (!doc.IsObject() && !doc.IsNull())
        {
            throw std::runtime_error("Received payload is not an object");
        }
        return {{type_name}}::FromRapidJsonObject(doc);
    }
};
{%- endmacro %}

{%- macro protobuf_wire(type_name) %}

template <>
struct Wire<{{type_name}}> {
    static constexpr const char* kContentType = "application/protobuf";

    static std::string ToString(const {{type_name}}& value)
    {
        std::string out;
        if (!value.SerializeToString(&out))
        {
            throw std::runtime_error("Could not serialize protobuf payload");
        }
        return out;
    }

    static {{type_name}} FromString(const std::string& payload)
    {
        {{type_name}} value;
        if (!value.ParseFromString(payload))
        {
            throw std::runtime_error("Could not parse protobuf payload");
        }
        return value;
    }
};
{%- endmacro %}
{#- One specialization per type, not per payload: two elements may name the same
