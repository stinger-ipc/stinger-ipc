
#include "signal_payloads.hpp"
#include <rapidjson/document.h>
#include <rapidjson/schema.h>

{% import "partials/deserialize.jinja2"  as deser %}
{% import "partials/serialize.jinja2" as ser %}
{% import "partials/validate.jinja2" as val %}

{%for ns in config.cpp.namespace%}
namespace {{ns}} {
{%endfor-%}
namespace {{stinger.name|snake_case}} {

{%for signal_name, signal in stinger.signals.items()%}
{%- if not signal.payload.is_protobuf %}
// --- (De-)Serialization for {{signal_name}} signal payload ---
{{signal.payload.cpp.class_name}} {{signal.payload.cpp.class_name}}::FromRapidJsonObject(const rapidjson::Value& jsonObj)
{
    {{signal.payload.cpp.class_name}} {{signal.name | lowerCamelCase }}Payload;
    {{deser.deserialize((signal.name|lowerCamelCase)+"Payload", signal.arg_list, 'jsonObj') | indent(4)}}

    return {{signal.name | lowerCamelCase }}Payload;
};

void {{signal.payload.cpp.class_name}}::AddToRapidJsonObject(rapidjson::Value& parent, rapidjson::Document::AllocatorType& allocator) const
{
    {%for arg in signal.arg_list%}
    {{ser.addToValue('parent', arg, 'allocator') | indent(4)}}
    {%- endfor %}
}
{{ val.validate_schema_body((signal_name | UpperCamelCase) ~ "Payload", signal.arg_list) }}
{%- endif %}
{% endfor %}

} // namespace {{stinger.name|snake_case}}
{%for ns in config.cpp.namespace|reverse%}
} // namespace {{ns}}
{%endfor-%}