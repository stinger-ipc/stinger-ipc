{%for method_name, method in stinger.methods.items()%}
void {{stinger.cpp.server_class_name}}::_call{{method_name | UpperCamelCase}}Handler(
        const std::string& topic, 
        const std::string& payload, 
        const std::optional<std::string>& optContentType,
        const std::optional<std::vector<std::byte>>& optCorrelationData,
        const std::optional<std::string>& optResponseTopic) const
{
    _broker->Log(LOG_INFO, "Handling call to {{method_name}}");
{%- if method.request_payload.enforce_content_type %}
    if (!optContentType.has_value() || optContentType.value() != "{{ codec.content_type(method.request_payload) }}")
    {
        _broker->Log(LOG_WARNING, "Received '{{method_name}}' request with content type '%s'; expected '{{ codec.content_type(method.request_payload) }}'.",
                     optContentType.value_or("(none)").c_str());
        if (optResponseTopic)
        {
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, stinger::error::MethodReturnCode::SERVER_DESERIALIZATION_ERROR,
                                                                 "Unsupported content type '" + optContentType.value_or("(none)") + "' for the '{{method_name}}' request; expected '{{ codec.content_type(method.request_payload) }}'");
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            _broker->Publish(errMsg);
        }
        return;
    }
{%- endif %}
    if (!_{{method_name | camelCase}}Handler) {
        // TODO: publish an error response because we don't have a method handler.
        return;
    }
    {%if method.arg_list | length > 0 %}
    auto requestArgs = Wire<{{method.request_payload.cpp.class_name}}>::FromString(payload);
{%- if not method.request_payload.is_protobuf %}
    if (!requestArgs.ValidateSchema()) {
        _broker->Log(LOG_WARNING, "Request payload for {{method_name}} failed schema validation.");
        if (optResponseTopic) {
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, stinger::error::MethodReturnCode::CLIENT_DESERIALIZATION_ERROR, "Request payload for {{method_name}} failed schema validation.");
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            {%-if method.version%}
            errMsg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(errMsg);
        }
        return;
    }
{%- endif %}
    {%endif%}
    try
    {
        {%if method.return_value is none %}
        // Method doesn't return a value.
        _{{method_name | camelCase}}Handler({%for arg in method.arg_list%}requestArgs.{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%});
        auto returnPayload = {{method.cpp.return_struct_name}}();
        {%else%}
        // Method returns a single value.
        auto returnValue = _{{method_name | camelCase}}Handler({%for arg in method.arg_list%}requestArgs.{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%});
        {{method.cpp.return_struct_name}} returnPayload = {returnValue};
        {%endif%}
{%- if not method.response_payload.is_protobuf %}
        if (!returnPayload.ValidateSchema()) {
            _broker->Log(LOG_WARNING, "Response payload for {{method_name}} failed schema validation.");
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, stinger::error::MethodReturnCode::SERVER_SERIALIZATION_ERROR, "Response payload for {{method_name}} failed schema validation.");
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            {%-if method.version%}
            errMsg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(errMsg);
            return;
        }
{%- endif %}

        if (optResponseTopic)
        {
            auto payloadStr = Wire<{{method.response_payload.cpp.class_name}}>::ToString(returnPayload);

            auto msg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, payloadStr, optCorrelationData, stinger::error::MethodReturnCode::SUCCESS);
            {{ codec.stamp_content_type(method.response_payload) }}
            {%-if method.version%}
            msg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(msg);
        }
    }
    catch (const stinger::error::StingerMethodException& e)
    {
        _broker->Log(LOG_ERR, "Exception in {{method_name}} method handler [%s]: %s", typeid(e).name(), e.what());
        if (optResponseTopic) {
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, e.code(), e.what());
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            {%-if method.version%}
            errMsg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(errMsg);
        }
    }
    catch (const std::exception& e)
    {
        _broker->Log(LOG_ERR, "Exception in {{method_name}} method handler [%s]: %s", typeid(e).name(), e.what());
        if (optResponseTopic) {
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, stinger::error::MethodReturnCode::SERVER_ERROR, e.what());
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            {%-if method.version%}
            errMsg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(errMsg);
        }
    }
    catch (...)
    {
        _broker->Log(LOG_ERR, "Unknown exception in {{method_name}} method handler");
        if (optResponseTopic) {
            auto errMsg = stinger::mqtt::Message::MethodResponse(*optResponseTopic, {{ codec.error_body(method.response_payload) }}, optCorrelationData, stinger::error::MethodReturnCode::UNKNOWN_ERROR, "Unknown exception in {{method_name}} method handler");
            {{ codec.stamp_content_type(method.response_payload, "errMsg") }}
            {%-if method.version%}
            errMsg.properties.version = "{{method.version}}";
            {%-endif%}
            _broker->Publish(errMsg);
        }
    }
}
{%endfor%}

{%for command_name, command in stinger.commands.items()%}
void {{stinger.cpp.server_class_name}}::receive{{command_name | UpperCamelCase}}Command(const std::function<void({%for arg in command.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%})>& handler)
{
    _broker->Log(LOG_DEBUG, "Application registered a function to handle {{command_name}} commands.");
    std::lock_guard<std::mutex> lock(_{{command_name | lowerCamelCase}}CommandHandlersMutex);
    _{{command_name | lowerCamelCase}}CommandHandlers.push_back(handler);
}

void {{stinger.cpp.server_class_name}}::receive{{command_name | UpperCamelCase}}CommandPayload(const std::function<void(const {{command.payload.cpp.class_name}}&)>& handler)
{
    _broker->Log(LOG_DEBUG, "Application registered a payload handler for {{command_name}} commands.");
    std::lock_guard<std::mutex> lock(_{{command_name | lowerCamelCase}}CommandHandlersMutex);
    _{{command_name | lowerCamelCase}}CommandPayloadHandlers.push_back(handler);
}

void {{stinger.cpp.server_class_name}}::_receive{{command_name | UpperCamelCase}}Command(const stinger::mqtt::Message& msg)
{
    // Commands have no response channel, so every failure below is logged and the
    // message is dropped; nothing is ever published back to the sender.
    if (msg.properties.debugInfo.has_value())
    {
        _broker->Log(LOG_INFO, "Received DebugInfo on topic %s: %s", msg.topic.c_str(), msg.properties.debugInfo->c_str());
    }

    {{ codec.expect_content_type(command.payload, command_name ~ " command") }}

    // Copy the handler list so the lock isn't held while the handlers run: a handler is
    // then free to register another one, and the list cannot change mid-iteration.
    std::vector<std::function<void({%for arg in command.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%})>> handlers;
    std::vector<std::function<void(const {{command.payload.cpp.class_name}}&)>> payloadHandlers;
    {
        std::lock_guard<std::mutex> lock(_{{command_name | lowerCamelCase}}CommandHandlersMutex);
        handlers = _{{command_name | lowerCamelCase}}CommandHandlers;
        payloadHandlers = _{{command_name | lowerCamelCase}}CommandPayloadHandlers;
    }
    if (handlers.empty() && payloadHandlers.empty())
    {
        _broker->Log(LOG_WARNING, "Received '{{command_name}}' command but no handler is registered; dropping it.");
        return;
    }

    try
    {
        auto commandPayload = Wire<{{command.payload.cpp.class_name}}>::FromString(msg.payload);
{%- if not command.payload.is_protobuf %}
        if (!commandPayload.ValidateSchema())
{%- endif %}
        {
            _broker->Log(LOG_WARNING, "Received '{{command_name}}' command payload failed schema validation; dropping it.");
            return;
        }

        for (const auto& payloadHandler : payloadHandlers)
        {
            try
            {
                payloadHandler(commandPayload);
            }
            catch (const std::exception& e)
            {
                _broker->Log(LOG_ERR, "Exception in {{command_name}} command payload handler [%s]: %s", typeid(e).name(), e.what());
            }
            catch (...)
            {
                _broker->Log(LOG_ERR, "Unknown exception in {{command_name}} command payload handler");
            }
        }

        for (const auto& handler : handlers)
        {
            try
            {
                handler({%for arg in command.arg_list%}commandPayload.{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%});
            }
            catch (const std::exception& e)
            {
                _broker->Log(LOG_ERR, "Exception in {{command_name}} command handler [%s]: %s", typeid(e).name(), e.what());
            }
            catch (...)
            {
                _broker->Log(LOG_ERR, "Unknown exception in {{command_name}} command handler");
            }
        }
    }
    catch (const std::exception& e)
    {
        _broker->Log(LOG_WARNING, "Could not deserialize '{{command_name}}' command payload [%s]: %s", typeid(e).name(), e.what());
    }
}
{%endfor%}

{%for prop_name, prop in stinger.properties.items()%}
{{pr.get_property_definition(stinger.cpp.server_class_name, prop_name, prop)}}

{{pr.callback_registration_definition(stinger.cpp.server_class_name, prop_name, prop)}}

void {{stinger.cpp.server_class_name}}::update{{prop.name | UpperCamelCase}}Property({{pr.value_params(prop)}})
{
    { // Scope lock
    std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyMutex);
        _{{prop_name | lowerCamelCase}}Property = {{pr.payload_expr(prop)}};
{%- if config.properties.version_tracking %}
        _last{{prop_name | UpperCamelCase}}PropertyVersion++;
{%- endif %}
    }
    { // Scope lock
        std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyCallbacksMutex);
        for (const auto& cb : _{{prop_name | lowerCamelCase}}PropertyCallbacks)
        {
            try
            {
                cb({{pr.value_args(prop)}});
            }
            catch (const std::exception& e)
            {
                _broker->Log(LOG_ERR, "Exception in {{prop_name}} property callback [%s]: %s", typeid(e).name(), e.what());
            }
            catch (...)
            {
                _broker->Log(LOG_ERR, "Unknown exception in {{prop_name}} property callback");
            }
        }
    }
    republish{{prop.name | UpperCamelCase}}Property();
}

void {{stinger.cpp.server_class_name}}::republish{{prop.name | UpperCamelCase}}Property() const
{
    std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyMutex);
    std::string payloadStr = "null";
    if (_{{prop_name | lowerCamelCase}}Property)
    {
{%- if not prop.payload.is_protobuf %}
        if (!_{{prop_name | lowerCamelCase}}Property->ValidateSchema()) {
            _broker->Log(LOG_WARNING, "Value for '{{prop_name}}' property failed schema validation; not publishing.");
            return;
        }
{%- endif %}
        payloadStr = Wire<{{prop.payload.cpp.class_name}}>::ToString(*_{{prop_name | lowerCamelCase}}Property);
    }

    std::map<std::string, std::string> topicArgs;
    topicArgs["service_id"] = _instanceId;
    topicArgs["interface_name"] = NAME;
    topicArgs["client_id"] = _broker->GetClientId();
    topicArgs["property_name"] = "{{prop_name}}";
    {%-for topic_param in stinger.topics.params %}
    topicArgs["{{topic_param}}"] = _{{topic_param|lowerCamelCase}}TopicParam;
    {%-endfor%}

    auto topic = stinger::utils::format("{{prop.value_topic()}}", topicArgs);
    auto msg = stinger::mqtt::Message::PropertyValue(topic, payloadStr, {%if config.properties.version_tracking%}_last{{prop_name | UpperCamelCase}}PropertyVersion{%else%}std::nullopt{%endif%});
    {{ codec.stamp_content_type(prop.payload) }}
    {%-if prop.version%}
    msg.properties.version = "{{prop.version}}";
    {%-endif%}
    _broker->Publish(msg);
}

void {{stinger.cpp.server_class_name}}::_receive{{prop_name | UpperCamelCase}}PropertyUpdate(const stinger::mqtt::Message& msg)
{
    if (msg.properties.debugInfo.has_value())
    {
        _broker->Log(LOG_INFO, "Received DebugInfo on topic %s: %s", msg.topic.c_str(), msg.properties.debugInfo->c_str());
    }

    // An update request names a topic to answer on, and the client that sent it is
    // waiting there, so every way out of this function reports what happened.  The
    // response carries the property's current value either way, so a client whose
    // request was rejected learns the value{%if config.properties.version_tracking%} and version{%endif%} it should have used.
    const std::optional<std::string>& optResponseTopic = msg.properties.responseTopic;
    const std::optional<std::vector<std::byte>>& optCorrelationData = msg.properties.correlationData;
    auto respond = [&](stinger::error::MethodReturnCode returnCode, const std::string& debugMessage)
    {
        if (!optResponseTopic)
        {
            _broker->Log(LOG_DEBUG, "No response topic on the '{{prop_name}}' property update request; not responding.");
            return;
        }
        try
        {
            std::string payloadStr = "null";
            {%if config.properties.version_tracking%}int currentVersion = -1;{%endif%}
            { // Scope lock
                std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyMutex);
                if (_{{prop_name | lowerCamelCase}}Property)
                {
                    payloadStr = Wire<{{prop.payload.cpp.class_name}}>::ToString(*_{{prop_name | lowerCamelCase}}Property);
                }
                {%-if config.properties.version_tracking%}
                currentVersion = _last{{prop_name | UpperCamelCase}}PropertyVersion;
                {%-endif%}
            }
            auto respMsg = debugMessage.empty()
                               ? stinger::mqtt::Message::PropertyUpdateResponse(*optResponseTopic, payloadStr, {%if config.properties.version_tracking%}currentVersion{%else%}std::nullopt{%endif%}, optCorrelationData, returnCode)
                               : stinger::mqtt::Message::PropertyUpdateResponse(*optResponseTopic, payloadStr, {%if config.properties.version_tracking%}currentVersion{%else%}std::nullopt{%endif%}, optCorrelationData, returnCode, debugMessage);
            {{ codec.stamp_content_type(prop.payload, "respMsg") }}
            {%-if prop.version%}
            respMsg.properties.version = "{{prop.version}}";
            {%-endif%}
            _broker->Publish(respMsg);
        }
        catch (const std::exception& e)
        {
            _broker->Log(LOG_ERR, "Could not publish the '{{prop_name}}' property update response [%s]: %s", typeid(e).name(), e.what());
        }
    };

    try
    {
{%- if prop.payload.enforce_content_type %}
        // Unlike the drop-on-arrival sites, this one has a response channel, so a bad
        // content type is reported to the client rather than silently ignored.
        if (!msg.properties.contentType.has_value() || msg.properties.contentType.value() != "{{ codec.content_type(prop.payload) }}")
        {
            throw stinger::error::ServerDeserializationErrorException(
                "Unsupported content type '" + msg.properties.contentType.value_or("(none)") + "' for an update of the '{{prop_name}}' property; expected '{{ codec.content_type(prop.payload) }}'");
        }
{%- else %}
        // `[protobuf] mime_type = false`: a '{{prop_name}}' update carries no content type,
        // so the body is assumed to be the declared protobuf message.
{%- endif %}

        // Deserialize the '{{prop_name}}' property value.
        {{prop.payload.cpp.class_name}} tempValue;
        try
        {
            tempValue = Wire<{{prop.payload.cpp.class_name}}>::FromString(msg.payload);
        }
        catch (const std::exception& e)
        {
            throw stinger::error::ServerDeserializationErrorException(
                std::string("Could not deserialize an update of the '{{prop_name}}' property: ") + e.what());
        }
{%- if not prop.payload.is_protobuf %}
        if (!tempValue.ValidateSchema())
        {
            throw stinger::error::ServerDeserializationErrorException("An update of the '{{prop_name}}' property failed schema validation");
        }
{%- endif %}

        { // Scope lock
            std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyMutex);
{%- if config.properties.version_tracking %}
            // Checked under the same lock as the assignment, so a request that raced
            // another update is rejected rather than silently overwriting it.  The
            // lock is released as the exception unwinds, before `respond` retakes it.
            const int requestVersion = msg.properties.propertyVersion.value_or(-1);
            if (requestVersion != _last{{prop_name | UpperCamelCase}}PropertyVersion)
            {
                throw stinger::error::OutOfSyncException(
                    "Update request for the '{{prop_name}}' property carries version " + std::to_string(requestVersion) + ", but its current version is " +
                    std::to_string(_last{{prop_name | UpperCamelCase}}PropertyVersion));
            }
{%- endif %}
            _{{prop_name | lowerCamelCase}}Property = tempValue;
{%- if config.properties.version_tracking %}
            _last{{prop_name | UpperCamelCase}}PropertyVersion++;
{%- endif %}
        }
        { // Scope lock
            // A client-driven update has to notify the same callbacks updateXProperty()
            // does, or application code has no way to learn that this property changed.
            std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyCallbacksMutex);
            for (const auto& cb : _{{prop_name | lowerCamelCase}}PropertyCallbacks)
            {
                try
                {
                    cb({{pr.value_from_payload(prop, 'tempValue')}});
                }
                catch (const std::exception& e)
                {
                    _broker->Log(LOG_ERR, "Exception in {{prop_name}} property callback [%s]: %s", typeid(e).name(), e.what());
                }
                catch (...)
                {
                    _broker->Log(LOG_ERR, "Unknown exception in {{prop_name}} property callback");
                }
            }
        }
        republish{{prop.name | UpperCamelCase}}Property();
        respond(stinger::error::MethodReturnCode::SUCCESS, "");
    }
    catch (const stinger::error::StingerMethodException& e)
    {
        _broker->Log(LOG_WARNING, "Rejected an update of the '{{prop_name}}' property: %s", e.what());
        respond(e.code(), e.what());
    }
    catch (const std::exception& e)
    {
        _broker->Log(LOG_ERR, "Error while updating the '{{prop_name}}' property [%s]: %s", typeid(e).name(), e.what());
        respond(stinger::error::MethodReturnCode::SERVER_ERROR, e.what());
    }
    catch (...)
    {
        _broker->Log(LOG_ERR, "Unknown error while updating the '{{prop_name}}' property");
        respond(stinger::error::MethodReturnCode::UNKNOWN_ERROR, "Unknown error while updating the '{{prop_name}}' property");
    }
}
