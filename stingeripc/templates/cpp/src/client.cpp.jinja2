constexpr const char {{stinger.cpp.client_class_name}}::NAME[];
constexpr const char {{stinger.cpp.client_class_name}}::INTERFACE_VERSION[];

{{stinger.cpp.client_class_name}}::{{stinger.cpp.client_class_name}}(std::shared_ptr<stinger::utils::IConnection> broker, const InstanceInfo& instanceInfo)
        : _broker(broker), _instanceId(instanceInfo.serviceId.value_or("error_service_id_not_found")), _instanceInfo(instanceInfo)
{
    _brokerMessageCallbackHandle = _broker->AddMessageCallback([this](const stinger::mqtt::Message& msg)
    {
        _receiveMessage(msg);
    });

    std::map<std::string, std::string> topicParams;
    topicParams["client_id"] = _broker->GetClientId();
    topicParams["service_id"] = _instanceInfo.serviceId.value_or("error_service_id_not_found");
    topicParams["interface_name"] = NAME;
    {%-for topic_param in config.topics.params %}
    topicParams["{{topic_param}}"] = _instanceInfo.{{topic_param|lowerCamelCase}}.value_or("error_{{topic_param}}_not_found");
    {%-endfor%}

    {%for sig_name, sig in stinger.signals.items() %}
    auto {{sig_name | lowerCamelCase}}Topic = stinger::utils::format("{{sig.topic()}}", topicParams);
    _{{sig_name | lowerCamelCase}}SignalSubscriptionId = _broker->Subscribe({{sig_name | lowerCamelCase}}Topic, {{stinger.signal_qos}});
    {%-endfor%}{# end signals for loop #}
    {%-for method_name, method in stinger.methods.items() %}
    { // Restrict scope
        auto {{method_name | lowerCamelCase}}ResponseTopic = stinger::utils::format("{{method.response_topic()}}", topicParams);
        std::stringstream responseTopicStringStream;
        responseTopicStringStream << stinger::utils::format({{method_name|lowerCamelCase}}ResponseTopic, topicParams);
        _{{method_name | lowerCamelCase}}MethodSubscriptionId = _broker->Subscribe(responseTopicStringStream.str(), {{stinger.method_response_qos}});
    }
    {%-endfor%}{# end methods for loop #}
    {%-for prop_name, prop in stinger.properties.items() %}
    auto {{prop_name | lowerCamelCase}}ValueTopic = stinger::utils::format("{{prop.value_topic()}}", topicParams);
    _{{prop_name | lowerCamelCase}}PropertySubscriptionId = _broker->Subscribe({{prop_name | lowerCamelCase}}ValueTopic, {{stinger.property_value_qos}});
    {%-endfor%}{# end properties for loop #}
    {%if stinger.properties|length > 0 %}
    auto anyPropertyUpdateResponseTopic = stinger::utils::format("{{stinger.all_properties_response_topic()}}", topicParams);
    _anyPropertyUpdateResponseSubscriptionId = _broker->Subscribe(anyPropertyUpdateResponseTopic, 1);
    {%endif%}{# end if properties #}
}

{{stinger.cpp.client_class_name}}::~{{stinger.cpp.client_class_name}}()
{
    if (_broker && _brokerMessageCallbackHandle != 0)
    {
        _broker->RemoveMessageCallback(_brokerMessageCallbackHandle);
        _brokerMessageCallbackHandle = 0;
    }
}

void {{stinger.cpp.client_class_name}}::_receiveMessage(const stinger::mqtt::Message& msg)
{
    const int noSubId = -1;
    int subscriptionId = msg.properties.subscriptionId.value_or(noSubId);
    _broker->Log(LOG_DEBUG, "Received message on topic %s with subscription id=%d", msg.topic.c_str(), subscriptionId);
    {%-for sig_name, sig in stinger.signals.items() %}
    if (subscriptionId == _{{sig_name | lowerCamelCase}}SignalSubscriptionId)
    {
        _broker->Log(LOG_INFO, "Handling {{sig_name}} signal");
        if (msg.properties.debugInfo.has_value())
        {
            _broker->Log(LOG_INFO, "{{sig_name}} signal debug from server: %s", msg.properties.debugInfo->c_str());
        }
        rapidjson::Document doc;
        try {
            if (_{{sig_name | camelCase}}SignalCallbacks.size() > 0)
            {
                rapidjson::ParseResult ok = doc.Parse(msg.payload.c_str());
                if (!ok)
                {
                    _broker->Log(LOG_WARNING, "Could not JSON parse {{sig_name}} signal payload.");
                    return;
                }

                if (!doc.IsObject()) {
                    _broker->Log(LOG_WARNING, "Received payload is not an object");
                    return;
                }

                {%for arg in sig.arg_list%}
                {{arg.cpp.temp_type}} temp{{arg.name|UpperCamelCase}};
                { // Scoping
                    rapidjson::Value::ConstMemberIterator itr = doc.FindMember("{{arg.name}}");
                    if (itr != doc.MemberEnd() && itr->value.Is{{arg.cpp.rapidjson_type}}()) {
                        {%if arg.arg_type.name.lower() == 'primitive'%}
                        temp{{arg.name|UpperCamelCase}} = itr->value.Get{{arg.cpp.rapidjson_type}}();
                        {%elif arg.arg_type.name.lower() == 'enum'%}
                        temp{{arg.name|UpperCamelCase}} = static_cast<{{arg.cpp.data_type}}>(itr->value.Get{{arg.cpp.rapidjson_type}}());
                        {%elif arg.arg_type.name.lower() == 'datetime'%}
                        std::istringstream ss(itr->value.GetString());
                        std::tm tm = {};
                        ss >> std::get_time(&tm, "%Y-%m-%dT%H:%M:%S");
                        if (ss.fail()) {
                            throw std::runtime_error("Failed to parse datetime string");
                        }
                        temp{{arg.name|UpperCamelCase}} = std::chrono::system_clock::from_time_t(std::mktime(&tm));
                        {%elif arg.arg_type.name.lower() == 'duration'%}
                        temp{{arg.name|UpperCamelCase}} = stinger::utils::parseIsoDuration(itr->value.GetString());
                        {%elif arg.arg_type.name.lower() == 'binary'%}
                        temp{{arg.name|UpperCamelCase}} = stinger::utils::base64Decode(itr->value.GetString());
                        {%endif%}
                    } else {
                    {%-if arg.optional%}
                        temp{{arg.name|UpperCamelCase}} = std::nullopt;
                    {%else%}
                        throw std::runtime_error("Received payload for '{{sig_name}}' doesn't have required value/type");
                    {%endif%}
                    }
                }
                {%endfor%}{# for signal args #}
                {{sig.payload.cpp.class_name}} signalPayload{ {%for arg in sig.arg_list%}temp{{arg.name|UpperCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%} };
{%- if not sig.payload.is_protobuf %}
                if (!signalPayload.ValidateSchema()) {
                    _broker->Log(LOG_WARNING, "Received '{{sig_name}}' signal payload failed schema validation; ignoring.");
                    return;
                }
{%- endif %}
                std::lock_guard<std::mutex> lock(_{{sig_name | lowerCamelCase}}SignalCallbacksMutex);
                for (const auto& cb : _{{sig_name | lowerCamelCase}}SignalCallbacks)
                {
                    try
                    {
                        cb({%for arg in sig.arg_list%}temp{{arg.name|UpperCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%});
                    }
                    catch (const std::exception& e)
                    {
                        _broker->Log(LOG_ERR, "Exception in {{sig_name}} signal callback [%s]: %s", typeid(e).name(), e.what());
                    }
                    catch (...)
                    {
                        _broker->Log(LOG_ERR, "Unknown exception in {{sig_name}} signal callback");
                    }
                }
            }
        }
        catch (const std::exception&)
        {
            // We couldn't find an integer out of the string in the topic name,
            // so we are dropping the message completely. 
            // TODO: Log this failure
        }
    }
    {%-endfor%}{# for signals #}

    {%-for method_name, method in stinger.methods.items() %}
    {%if not loop.first%}else {%endif%}if (subscriptionId == _{{method_name | lowerCamelCase}}MethodSubscriptionId)
    {
        _broker->Log(LOG_DEBUG, "Matched topic for {{method_name}} response");
        _handle{{method_name|UpperCamelCase}}Response(msg);
    }
    {%-endfor%}{# for methods #}
    {%-for prop_name, prop in stinger.properties.items() %}
    {%if not loop.first%}else {%endif%}if (subscriptionId == _{{prop_name | lowerCamelCase}}PropertySubscriptionId)
    {
        _receive{{prop_name | UpperCamelCase}}PropertyUpdate(msg);
    }
    {%-endfor%}{# for properties #}
    {%if stinger.properties|length > 0 %}else if (subscriptionId == _anyPropertyUpdateResponseSubscriptionId)
    {
        _broker->Log(LOG_DEBUG, "Matched topic for any property update response");
    }
    {%endif%}{# end if properties #}
}


{%-for sig_name, sig in stinger.signals.items() %}
void {{stinger.cpp.client_class_name}}::register{{sig_name | UpperCamelCase}}Callback(const std::function<void({%for arg in sig.arg_list%}{{arg.cpp.temp_type}}{%if not loop.last%}, {%endif%}{%endfor%})>& cb)
{
    std::lock_guard<std::mutex> lock(_{{sig_name | lowerCamelCase}}SignalCallbacksMutex);
    _{{sig_name | lowerCamelCase}}SignalCallbacks.push_back(cb);
}
{%-endfor%}

{%for method_name, method in stinger.methods.items()%}
std::future<{{method.cpp.return_value_class}}> {{stinger.cpp.client_class_name}}::{{method_name | camelCase}}({%for arg in method.arg_list%}{{arg.cpp.temp_type}} {{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%})
{
    std::vector<std::byte> correlationData = stinger::utils::generate_uuid_bytes();
    _pending{{method_name|UpperCamelCase}}MethodCalls[correlationData] = std::promise<{{method.cpp.return_value_class}}>();

    {{method.request_payload.cpp.class_name}} requestArgs{ {%for arg in method.arg_list%}{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%} };
{%- if not method.request_payload.is_protobuf %}
    if (!requestArgs.ValidateSchema()) {
        _broker->Log(LOG_WARNING, "Request payload for '{{method_name}}' failed schema validation; not sending.");
        _pending{{method_name|UpperCamelCase}}MethodCalls[correlationData].set_exception(
            std::make_exception_ptr(std::runtime_error("Request payload for '{{method_name}}' failed schema validation")));
        return _pending{{method_name|UpperCamelCase}}MethodCalls[correlationData].get_future();
    }
{%- endif %}
    auto payloadStr = Wire<{{method.request_payload.cpp.class_name}}>::ToString(requestArgs);

    std::map<std::string, std::string> topicParams;
    topicParams["client_id"] = _broker->GetClientId();
    topicParams["service_id"] = _instanceInfo.serviceId.value_or("error_service_id_not_found");
    topicParams["interface_name"] = NAME;
    {%-for topic_param in config.topics.params %}
    topicParams["{{topic_param}}"] = _instanceInfo.{{topic_param|lowerCamelCase}}.value_or("error_{{topic_param}}_not_found");
    {%-endfor%}

    auto responseTopic = stinger::utils::format("{{method.response_topic()}}", topicParams);
    auto requestTopic = stinger::utils::format("{{method.request_topic()}}", topicParams);
    auto msg = stinger::mqtt::Message::MethodRequest(requestTopic, payloadStr, correlationData, responseTopic);

    _broker->Publish(msg);

    return _pending{{method_name|UpperCamelCase}}MethodCalls[correlationData].get_future();
}

void {{stinger.cpp.client_class_name}}::_handle{{method_name|UpperCamelCase}}Response(
        const stinger::mqtt::Message& msg) 
{
    _broker->Log(LOG_DEBUG, "In response handler for {{method_name}}");
    if (msg.properties.debugInfo.has_value())
    {
        _broker->Log(LOG_INFO, "{{method_name}} response debug from server: %s", msg.topic.c_str(), msg.properties.debugInfo->c_str());
    }
    
    auto correlationData = msg.properties.correlationData.value_or(std::vector<std::byte>{});
    auto promiseItr = _pending{{method_name|UpperCamelCase}}MethodCalls.find(correlationData);
    if (promiseItr != _pending{{method_name|UpperCamelCase}}MethodCalls.end())
    {
        if (msg.properties.returnCode && (static_cast<stinger::error::MethodReturnCode>(*(msg.properties.returnCode)) != stinger::error::MethodReturnCode::SUCCESS))
        {
            // The method call failed, so set an exception on the promise.
            promiseItr->second.set_exception(createStingerException(static_cast<stinger::error::MethodReturnCode>(msg.properties.returnCode.value_or(static_cast<int>(stinger::error::MethodReturnCode::UNKNOWN_ERROR))), msg.properties.debugInfo.value_or("Exception returned via MQTT")));
            return;
        }

        // Found the promise for this correlation ID.
        {%if method.return_value is none %}
        // Method doesn't return a value.
        promiseItr->second.set_value();
        {%else%}
        // Method returns a single value.
        auto returnPayload = Wire<{{method.response_payload.cpp.class_name}}>::FromString(msg.payload);
{%- if not method.response_payload.is_protobuf %}
        if (!returnPayload.ValidateSchema()) {
            _broker->Log(LOG_WARNING, "Response payload for '{{method_name}}' failed schema validation.");
            promiseItr->second.set_exception(
                std::make_exception_ptr(std::runtime_error("Response payload for '{{method_name}}' failed schema validation")));
            return;
        }
{%- endif %}
        promiseItr->second.set_value(returnPayload.{{method.return_value.name|lowerCamelCase}});
        {%endif%}
    }

    _broker->Log(LOG_DEBUG, "End of response handler for {{method_name}}");
}
{%endfor%}{# end for each method #}
{%for command_name, command in stinger.commands.items()%}
void {{stinger.cpp.client_class_name}}::send{{command_name | UpperCamelCase}}Command({%for arg in command.arg_list%}{{arg.cpp.func_param_type}} {{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%})
{
    {{command.cpp.payload_struct_name}} commandPayload{ {%for arg in command.arg_list%}{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%} };
{%- if not command.payload.is_protobuf %}
    if (!commandPayload.ValidateSchema()) {
        _broker->Log(LOG_WARNING, "Payload for '{{command_name}}' command failed schema validation; not sending.");
        return;
    }
{%- endif %}

    send{{command_name | UpperCamelCase}}CommandPayload(commandPayload);
}

void {{stinger.cpp.client_class_name}}::send{{command_name | UpperCamelCase}}CommandPayload(const {{command.payload.cpp.class_name}}& commandPayload)
{
    auto payloadStr = Wire<{{command.payload.cpp.class_name}}>::ToString(commandPayload);

    std::map<std::string, std::string> topicParams;
    topicParams["client_id"] = _broker->GetClientId();
    topicParams["service_id"] = _instanceInfo.serviceId.value_or("error_service_id_not_found");
    topicParams["interface_name"] = NAME;
    {%-for topic_param in config.topics.params %}
    topicParams["{{topic_param}}"] = _instanceInfo.{{topic_param|lowerCamelCase}}.value_or("error_{{topic_param}}_not_found");
    {%-endfor%}

    auto topic = stinger::utils::format("{{command.topic()}}", topicParams);

    // Commands are fire-and-forget, so the message carries no response topic and no
    // correlation data; nothing comes back from the server.
    stinger::mqtt::Properties commandProperties;
    commandProperties.contentType = "{{ codec.content_type(command.payload) }}";
    {%-if command.version%}
    commandProperties.version = "{{command.version}}";
    {%-endif%}
    auto msg = stinger::mqtt::Message(topic, payloadStr, {{stinger.command_qos}}, false, commandProperties);

    _broker->Publish(msg);
}
{%endfor%}{# end for each command #}
{%for prop_name, prop in stinger.properties.items()%}
void {{stinger.cpp.client_class_name}}::_receive{{prop_name | UpperCamelCase}}PropertyUpdate(const stinger::mqtt::Message& msg)
{
    if (msg.properties.debugInfo.has_value())
    {
        _broker->Log(LOG_INFO, "{{prop_name}} property update debug from server: %s",  msg.properties.debugInfo->c_str());
    }
    auto tempValue = Wire<{{prop.payload.cpp.class_name}}>::FromString(msg.payload);
{%- if not prop.payload.is_protobuf %}
    if (!tempValue.ValidateSchema()) {
        _broker->Log(LOG_WARNING, "Received '{{prop_name}}' property update failed schema validation; ignoring.");
        return;
    }
{%- endif %}

    { // Scope lock
        std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyMutex);
        _{{prop_name | lowerCamelCase}}Property = tempValue;
        _last{{prop_name | UpperCamelCase}}PropertyVersion = msg.properties.propertyVersion ? *msg.properties.propertyVersion : -1;
    }
    // Notify all registered callbacks.
    { // Scope lock
        std::lock_guard<std::mutex> lock(_{{prop_name | lowerCamelCase}}PropertyCallbacksMutex);
        for (const auto& cb : _{{prop_name | lowerCamelCase}}PropertyCallbacks)
        {
            // Don't need a mutex since we're using tempValue.
            try
            {
                cb({%for arg in prop.arg_list %}tempValue.{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%});
            }
            catch (const std::exception& e)
            {
                _broker->Log(LOG_ERR, "Exception in {{prop_name}} property callback [%s]: %s", typeid(e).name(), e.what());
            }
            catch (...)
            {
                _broker->Log(LOG_ERR, "Unknown exception in {{prop_name}} property callback");
            }
        }
    }
}


