{% if not prop.read_only %}
std::future<bool> {{stinger.cpp.client_class_name}}::update{{prop.name | UpperCamelCase}}Property({{ar.methodParams(prop.arg_list)}}) const
{
    {{prop.payload.cpp.class_name}} propertyPayload{ {%for arg in prop.arg_list%}{{arg.name|lowerCamelCase}}{%if not loop.last%}, {%endif%}{%endfor%} };
    auto payloadStr = Wire<{{prop.payload.cpp.class_name}}>::ToString(propertyPayload);

    std::map<std::string, std::string> topicParams;
    topicParams["client_id"] = _broker->GetClientId();
    topicParams["service_id"] = _instanceInfo.serviceId.value_or("error_service_id_not_found");
    topicParams["interface_name"] = NAME;
    {%-for topic_param in config.topics.params %}
    topicParams["{{topic_param}}"] = _instanceInfo.{{topic_param|lowerCamelCase}}.value_or("error_{{topic_param}}_not_found");
    {%-endfor%}

    std::string update_topic = stinger::utils::format("{{prop.update_topic()}}", topicParams);
    std::string response_topic = stinger::utils::format("{{prop.response_topic()}}", topicParams);
    auto correlationData = stinger::utils::generate_uuid_bytes();
    auto msg = stinger::mqtt::Message::PropertyUpdateRequest(update_topic, payloadStr, _last{{prop_name | UpperCamelCase}}PropertyVersion, correlationData, response_topic);
    return _broker->Publish(msg);

}
