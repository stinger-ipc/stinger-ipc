{#
    The wire codec for one payload, and the shape of the API it gives.

    Every macro here takes a `Payload` and answers one question about that
    payload: how it crosses the wire, or what the generated functions carrying it
    take and hand over.  Each contains exactly one `is_protobuf` test, so the
    publish and receive code in client.py/server.py is written once and does not
    branch on the encoding itself.

    A JSON payload spreads into its declared arguments and a protobuf payload
    into the fields of its message; `payload.python.params` is that list either
    way, so the parameter-shaped macros below iterate it rather than the
    (protobuf-empty) `arg_list`.

    Import into a template with:
        {% import "partials/codec.jinja2" as codec %}

    Imported macros do not inherit the calling template's context, so anything
    they need is passed in explicitly.  Arguments named `*_expr` are fragments of
    generated Python (a variable name or expression), not values.
#}

{# The MQTT content type messages carrying this payload are published with. #}
{%- macro content_type(payload) -%}
{{ payload.content_type }}
{%- endmacro -%}

{#
    The protoc-generated modules this interface's protobuf payloads come from.

    Emitted once per module even when several payloads share it, and nothing at
    all for an interface that uses no protobuf messages.
#}
{%- macro imports(stinger) -%}
{%- for import_statement in stinger.protobuf_messages() | map(attribute='python.import_statement') | unique | sort %}
{{ import_statement }}
{%- endfor -%}
{%- endmacro -%}

{#
    The same imports, for a file that lives outside the generated package (an
    example script or a test module). `imports()` above uses a relative import
    for this interface's own bundled messages, which only resolves from inside the
    package itself, so this spells the same module out by its absolute name
    instead. Messages whose bindings the host supplies are already imported
    absolutely, so they come out the same either way.
#}
{%- macro example_imports(stinger, module_name) -%}
{%- for ref in stinger.protobuf_messages() | unique(attribute='python.module') | sort(attribute='python.module') %}
{{ ref.python.absolute_import_statement(module_name) }}
{%- endfor -%}
{%- endmacro -%}

{# Expression turning a payload object into the bytes that go on the wire. #}
{%- macro encode(payload, obj_expr) -%}
{%- if payload.is_protobuf -%}
{{ obj_expr }}.SerializeToString()
{%- else -%}
{{ obj_expr }}.model_dump_json(by_alias=True).encode("utf-8")
{%- endif -%}
{%- endmacro -%}

{# Expression turning wire bytes back into a payload object. #}
{%- macro decode(payload, buf_expr) -%}
{%- if payload.is_protobuf -%}
{{ payload.python.class_name }}.FromString({{ buf_expr }})
{%- else -%}
{{ payload.python.class_name }}.model_validate_json({{ buf_expr }})
{%- endif -%}
{%- endmacro -%}

{#
    The parameter list of a generated function carrying this payload -- what an
    application handler declares, and what a caller passes.

    One annotated parameter per declared argument for a JSON payload, and one per
    field of the message for a protobuf payload.  A protobuf field a caller may
    leave unset (a proto3 `optional`, or a member of a real `oneof`) defaults to
    `None`; those come last in `params`, so the defaults land where Python needs
    them.

    JSON parameter names are snake_cased, matching the field names `model_dump()`
    produces -- the client's signal dispatch calls a handler with
    `**model.model_dump()`, whose keys are the model's (snake_case) Python
    field names, not the arg's original (possibly camelCase) declared name.  A
    handler declared with the raw name would raise a `TypeError` for any
    argument whose declared name is not already snake_case.  A protobuf
    parameter keeps the proto field name, since that is the keyword its message
    constructor takes.
#}
{%- macro handler_params(payload, arg_list) -%}
{%- if payload.is_protobuf -%}
{%- for field in payload.python.params %}{{ field.python.param_name }}: {{ field.python.annotation }}{% if field.is_optional_param %} = None{% endif %}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- else -%}
{%- for arg in arg_list %}{{ arg.name|snake_case }}: {{ arg.python.annotation }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro -%}

{#
    The same parameters as bare types, for the `Callable[[...]]` of a callback
    type alias.  An optional parameter's default has no place in a `Callable`,
    so only the annotations appear.
#}
{%- macro param_types(payload, arg_list) -%}
{%- if payload.is_protobuf -%}
{%- for field in payload.python.params %}{{ field.python.annotation }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- else -%}
{%- for arg in arg_list %}{{ arg.python.annotation }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro -%}

{#
    Building a protobuf message out of the parameters `handler_params` declared.

    Every parameter is passed as a constructor keyword, including the optional
    ones: the protobuf runtime reads a `None` keyword as "not given", so there is
    nothing to guard.  A message with no fields -- `google.protobuf.Empty`, say --
    is simply default-constructed.
#}
{%- macro build_message(payload) -%}
{{ payload.python.class_name }}({% for field in payload.python.params %}{{ field.python.ctor_kwarg }}{% if not loop.last %}, {% endif %}{% endfor %})
{%- endmacro -%}

{#
    The keyword arguments a dispatcher calls a handler with: one indented line
    each, so a call site writes `handler(` before it and a closing `)` on its own
    line after it.

    A JSON payload reads its fields off the decoded model; a protobuf payload
    reads them off the message, copying repeated and map fields out of their
    protobuf containers and reporting an unset optional field as `None`.
#}
{%- macro handler_keywords(payload, arg_list, obj_expr) -%}
{%- if payload.is_protobuf -%}
{%- for field in payload.python.params %}
                {{ field.python.param_name }}={{ field.python.read_expr(obj_expr) }},{% endfor -%}
{%- else -%}
{%- for arg in arg_list %}
                {{ arg.name|snake_case }}={{ obj_expr }}.{{ arg.name|snake_case }},{% endfor -%}
{%- endif -%}
{%- endmacro -%}

{#
    The positional arguments a dispatcher calls a handler with, as a trailing-
    comma list ready to sit inside brackets.  One entry per declared argument for
    a JSON payload, one per message field for a protobuf payload.
#}
{%- macro handler_positional(payload, arg_list, obj_expr) -%}
{%- if payload.is_protobuf -%}
{%- for field in payload.python.params %}{{ field.python.read_expr(obj_expr) }}, {% endfor -%}
{%- else -%}
{%- for arg in arg_list %}{{ obj_expr }}.{{ arg.name|snake_case }}, {% endfor -%}
{%- endif -%}
{%- endmacro -%}

{#
    The interpolations a demo's print statement shows a payload's parameters with,
    inside an f-string.

    `labeled` prefixes each with the name the interface declares (as opposed to
    the generated parameter's own spelling); `lead` goes inside the brace, and
    `sep`/`end` are the separator between entries and the text after the last.
    A `bytes` parameter is shown with `!r`, since its value is not text.
#}
{%- macro example_print(payload, arg_list, labeled=True, lead="", sep=", ", end="") -%}
{%- for param in payload.python.params %}{% if labeled %}{{ param.name }}={% endif %}{{ "{" }}{{ lead }}{{ param.python.param_name }}{% if 'bytes' in param.python.annotation %}!r{% endif %}}{% if not loop.last %}{{ sep }}{% endif %}{% endfor %}{% if payload.python.params %}{{ end }}{% endif -%}
{%- endmacro -%}

{#
    Message constructors.

    The JSON forms call the `MessageCreator` helper for their message kind; the
    protobuf forms call its `binary_*` counterpart with encoded bytes and an
    explicit content type.  The two are the same underlying constructor -- the
    JSON helpers delegate to the binary ones -- so the only difference is who
    does the encoding.
#}
{%- macro signal_message(payload, topic_expr, obj_expr) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_signal_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}")
{%- else -%}
MessageCreator.signal_message({{ topic_expr }}, {{ obj_expr }})
{%- endif -%}
{%- endmacro -%}

{%- macro command_message(payload, topic_expr, obj_expr, qos) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_command_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}", qos={{ qos }})
{%- else -%}
MessageCreator.command_message({{ topic_expr }}, {{ obj_expr }}, qos={{ qos }})
{%- endif -%}
{%- endmacro -%}

{#
    A method request.

    `expiry_expr` is the calling method's own timeout in seconds; it becomes the
    message's expiry interval so the broker stops trying to deliver a request whose
    caller has already timed out and stopped listening for the response.
#}
{%- macro request_message(payload, topic_expr, obj_expr, response_topic_expr, correlation_expr, expiry_expr) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_request_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}", {{ response_topic_expr }}, {{ correlation_expr }}, {{ expiry_expr }})
{%- else -%}
MessageCreator.request_message({{ topic_expr }}, {{ obj_expr }}, {{ response_topic_expr }}, {{ correlation_expr }}, {{ expiry_expr }})
{%- endif -%}
{%- endmacro -%}

{%- macro response_message(payload, topic_expr, obj_expr, return_code_expr, correlation_expr) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_response_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}", {{ return_code_expr }}, {{ correlation_expr }})
{%- else -%}
MessageCreator.response_message({{ topic_expr }}, {{ obj_expr }}, {{ return_code_expr }}, {{ correlation_expr }})
{%- endif -%}
{%- endmacro -%}

{%- macro property_state_message(payload, topic_expr, obj_expr, version_expr) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_property_state_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}", {{ version_expr }})
{%- else -%}
MessageCreator.property_state_message({{ topic_expr }}, {{ obj_expr }}, {{ version_expr }})
{%- endif -%}
{%- endmacro -%}

{%- macro property_response_message(payload, topic_expr, obj_expr, version_expr, return_code_expr, correlation_expr, debug_expr=None) -%}
{%- if payload.is_protobuf -%}
MessageCreator.binary_property_response_message({{ topic_expr }}, {{ encode(payload, obj_expr) }}, "{{ payload.content_type }}", {{ version_expr }}, {{ return_code_expr }}, {{ correlation_expr }}{% if debug_expr %}, {{ debug_expr }}{% endif %})
{%- else -%}
MessageCreator.property_response_message({{ topic_expr }}, {{ obj_expr }}, {{ version_expr }}, {{ return_code_expr }}, {{ correlation_expr }}{% if debug_expr %}, {{ debug_expr }}{% endif %})
{%- endif -%}
{%- endmacro -%}

{#
    The payload argument(s) of a MessageCreator call, for call sites that are
    written across several lines and want to keep that shape.  A JSON payload is
    passed as the model object; a protobuf payload becomes encoded bytes plus an
    explicit content type, matching the `binary_*` signatures.  Pair it with
    `binary_prefix()` on the method name.
#}
{%- macro payload_arg(payload, obj_expr) -%}
{%- if payload.is_protobuf -%}
{{ encode(payload, obj_expr) }}, "{{ payload.content_type }}",
{%- else -%}
{{ obj_expr }},
{%- endif -%}
{%- endmacro -%}

{# Emits "binary_" when the payload needs the bytes-taking MessageCreator entry point. #}
{%- macro binary_prefix(payload) -%}
{%- if payload.is_protobuf %}binary_{% endif -%}
{%- endmacro -%}

{#
    A property's value and the payload that carries it.

    A JSON property wraps its single value in a generated model with one named
    field, so the two directions are a construction and a field access.  A
    protobuf property's value *is* the message, so both are the identity.
#}
{%- macro property_wrap(prop, value_expr) -%}
{%- if prop.payload.is_protobuf -%}
{{ value_expr }}
{%- else -%}
{{ prop.payload.python.class_name }}({{ prop.value.name|snake_case }}={{ value_expr }})
{%- endif -%}
{%- endmacro -%}

{%- macro property_unwrap(prop, obj_expr) -%}
{%- if prop.payload.is_protobuf -%}
{{ obj_expr }}
{%- else -%}
{{ obj_expr }}.{{ prop.value.name|snake_case }}
{%- endif -%}
{%- endmacro -%}

{#
    The example arguments of a protobuf message, as constructor keywords.

    A message left at its defaults serializes to zero bytes, and a zero-byte
    retained publish tells the broker to drop a property's retained value rather
    than store an empty one, so the example fills in what it can.  A field whose
    shape the descriptor does not describe -- a repeated field, a map, a message
    or an enum -- gets its empty value, which is still a value its parameter
    accepts.
#}
{%- macro example_kwargs(payload, seed=2) -%}
{%- for field in payload.python.example_params %}{{ field.python.param_name }}={{ field.python.example_value(seed) }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- endmacro -%}

{#
    The same example arguments as a dict literal, for a generated test that wants
    to pass them to the API and rebuild the expected message from the same values.
#}
{%- macro example_kwargs_dict(payload, seed=2) -%}
{% raw %}{{% endraw %}{% for field in payload.python.example_params %}"{{ field.python.param_name }}": {{ field.python.example_value(seed) }}{% if not loop.last %}, {% endif %}{% endfor %}{% raw %}}{% endraw %}
{%- endmacro -%}

{#
    An example instance of a payload's protobuf message.  A message with nothing
    to fill in (`google.protobuf.Empty`, say) is simply default-constructed.
#}
{%- macro example_message(payload, seed=2) -%}
{{ payload.python.class_name }}({{ example_kwargs(payload, seed) }})
{%- endmacro -%}

{#
    The argument list of an example call, for demos and generated tests.

    Both encodings spread into the individual parameters the generated API takes,
    with example values.  `named` picks between `name=value` and bare positional
    values, since the demo templates call the generated API both ways; a protobuf
    field a caller may leave unset is always named, because such parameters come
    last and an example does not necessarily fill in every one of them.
#}
{%- macro example_payload(payload, arg_list, named=True) -%}
{%- if payload.is_protobuf -%}
{%- for field in payload.python.example_params %}{% if named or field.is_optional_param %}{{ field.python.param_name }}={% endif %}{{ field.python.example_value() }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- else -%}
{%- for arg in arg_list %}{% if named %}{{ arg.name|snake_case }}={% endif %}{{ arg.get_random_example_value() }}{% if not loop.last %}, {% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro -%}

{# An example value for a property, for demos and generated tests.

    `seed` selects which example is picked; two calls with the same seed give the
    same value (the default matches every existing call site), while a different
    seed is how a generated integration test gets a second value guaranteed to
    differ from the first, to prove a write actually changed something.
#}
{%- macro property_example(prop, seed=2) -%}
{%- if prop.payload.is_protobuf -%}
{{ example_message(prop.payload, seed=seed) }}
{%- else -%}
{{ prop.value.get_random_example_value(lang="python", seed=seed) }}
{%- endif -%}
{%- endmacro -%}
