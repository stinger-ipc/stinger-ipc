class TestClient:
    """Tests for client initialization."""

    def test_client_initializes(self, client):
        """Test that client initializes successfully."""
        assert client is not None, "Client failed to initialize"
        assert client.service_id == "x", "Client service_id does not match expected value"

{%if stinger.properties | length > 0 %}
class TestClientProperties:

    def test_client_properties_initialization(self, client, initial_property_values):
        """Test that client properties are initialized correctly."""
        {%for prop_name, prop in stinger.properties.items()%}
        assert hasattr(client, '{{prop_name|snake_case}}'), "Client missing property '{{prop_name|snake_case}}'"
        {%-if not prop.value.optional%}
        assert client.{{prop_name|snake_case}} is not None, "Property '{{prop_name|snake_case}}' not initialized properly"
        {%-endif%}
        assert client.{{prop_name|snake_case}} == initial_property_values.{{prop_name|snake_case}}, "Property '{{prop_name|snake_case}}' value does not match expected value"
        {%endfor%}

    {%for prop_name, prop in stinger.properties.items()%}
    {%- if not prop.read_only %}
    def test_{{prop_name|snake_case}}_setter(self, mock_connection, client):
        mock_connection.clear_published_messages()

        new_{{prop_name | snake_case}}_value = {{prop.value.get_random_example_value()}}
        client.{{prop_name|snake_case}} = new_{{prop_name | snake_case}}_value

        published_msg = mock_connection.published_messages[-1]
        assert published_msg.qos == {{stinger.property_update_qos}}, "Property '{{prop_name|snake_case}}' setter published message with incorrect QoS"
        assert published_msg.retain is False, "Property '{{prop_name|snake_case}}' setter published message with incorrect retain flag"
        assert published_msg.content_type == "application/json", "Property '{{prop_name|snake_case}}' setter published message with incorrect content type"
        published_msg_json_obj = json.loads(published_msg.payload)
        new_{{prop_name | snake_case}}_obj = {{-prop.python.model_class_name}}({{prop.value.name|snake_case}}=new_{{prop_name | snake_case}}_value)
        assert json.loads(new_{{prop_name | snake_case}}_obj.model_dump_json(by_alias=True)) == published_msg_json_obj, "Property '{{prop_name|snake_case}}' setter did not publish the correct JSON payload"
    {%endif%}{# don't generate for readonly#}
    {%-endfor%}{# each property#}
{%endif%}
