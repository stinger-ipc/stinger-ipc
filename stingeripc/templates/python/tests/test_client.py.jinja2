{%if stinger.signals | length > 0 %}
class TestClientSignals:
    """The client subscribes to a signal only once a handler is registered."""

    {%for sig_name, sig in stinger.signals.items()%}
    def test_{{sig_name|snake_case}}_subscribes_when_handler_registered(self, mock_connection, client):
        before = mock_connection.get_subscription_count()

        client.receive_{{sig_name|snake_case}}({%if sig.payload.is_protobuf%}lambda payload: None{%else%}lambda **kwargs: None{%endif%})
        assert mock_connection.get_subscription_count() == before + 1, "Registering a '{{sig_name|snake_case}}' handler did not subscribe to the signal"

        # A second handler of either kind reuses the one subscription.
        client.receive_{{sig_name|snake_case}}_payload(lambda payload: None)
        assert mock_connection.get_subscription_count() == before + 1, "Registering a second '{{sig_name|snake_case}}' handler subscribed again"
    {%- if sig.payload.is_protobuf %}

    def test_{{sig_name|snake_case}}_delivers_the_message_to_every_handler(self, mock_connection, client):
        """A protobuf signal has no arguments to spread, so each handler is given the message."""
        received = [] # type: list
        client.receive_{{sig_name|snake_case}}(lambda payload: received.append(("recv", payload)))
        client.receive_{{sig_name|snake_case}}_payload(lambda payload: received.append(("payload", payload)))

        sent = {{sig.payload.python.class_name}}()
        topic = "{{sig.topic() | regex_replace("\{[A-Za-z_]+\}", "x") }}"
        mock_connection.simulate_message({{ codec.signal_message(sig.payload, "topic", "sent") }})

        assert len(received) == 2, f"Both '{{sig_name|snake_case}}' handlers should have been called, but got {received}"
        for kind, payload in received:
            assert isinstance(payload, {{sig.payload.python.class_name}}), f"The {kind} handler was called with {type(payload)} rather than the message"
            assert payload == sent, f"The {kind} handler did not receive the message that was sent"
    {%- endif %}
    {%endfor%}
{%endif%}

