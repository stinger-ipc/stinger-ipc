class TestClientProperties:
    """The client subscribes to a property only once the application asks for it."""

    {%for prop_name, prop in stinger.properties.items()%}
    def test_{{prop_name|snake_case}}_subscribes_when_handler_registered(self, mock_connection, client):
        before = mock_connection.get_subscription_count()

        client.{{prop_name|snake_case}}_changed(lambda value: None)
        assert mock_connection.get_subscription_count() == before + 1, "Registering a '{{prop_name|snake_case}}' handler did not subscribe to the property"

        # A second handler reuses the one subscription.
        client.{{prop_name|snake_case}}_changed(lambda value: None)
        assert mock_connection.get_subscription_count() == before + 1, "Registering a second '{{prop_name|snake_case}}' handler subscribed again"

    def test_{{prop_name|snake_case}}_getter_subscribes_and_returns_value(self, mock_connection, client):
        before = mock_connection.get_subscription_count()
        expected_{{prop_name|snake_case}} = {{ codec.property_example(prop) }}

        # The getter blocks until a value arrives, so subscribe first (by registering a
        # handler), deliver the value, and only then read it.
        client.{{prop_name|snake_case}}_changed(lambda value: None)
        assert mock_connection.get_subscription_count() == before + 1, "Not subscribed to the '{{prop_name|snake_case}}' property value topic"
        publish_{{prop_name|snake_case}}_value(mock_connection, expected_{{prop_name|snake_case}})

        assert client.{{prop_name|snake_case}} == expected_{{prop_name|snake_case}}, "Property '{{prop_name|snake_case}}' getter did not return the received value"

    def test_{{prop_name|snake_case}}_getter_raises_without_a_value(self, monkeypatch, mock_connection, client):
        # Nothing publishes a value, so the getter should give up and raise.
        monkeypatch.setattr(client_module, "PROPERTY_VALUE_TIMEOUT_SECONDS", 0.05)
        before = mock_connection.get_subscription_count()

        with pytest.raises(PropertyValueUnavailableError):
            _ = client.{{prop_name|snake_case}}

        assert mock_connection.get_subscription_count() == before + 1, "The '{{prop_name|snake_case}}' getter did not subscribe to the property"

    {%- if not prop.payload.is_protobuf %}{#- a protobuf property has no example field values to compare #}
    {%- if not prop.read_only %}
    def test_{{prop_name|snake_case}}_setter(self, mock_connection, client):
        {%if config.properties.version_tracking-%}
        # An update request carries the version of the value the client last saw, so the
        # property has to have been received before it can be set.
        {%else-%}
        # The setter waits for the server's current value, so the property has to have been
        # received before it can be set.
        {%endif-%}
        client.{{prop_name|snake_case}}_changed(lambda value: None)
        publish_{{prop_name|snake_case}}_value(mock_connection, {{ codec.property_example(prop) }})
        mock_connection.clear_published_messages()

        new_{{prop_name | snake_case}}_value = {{ codec.property_example(prop) }}
        client.{{prop_name|snake_case}} = new_{{prop_name | snake_case}}_value

        published_msg = mock_connection.published_messages[-1]
        assert published_msg.qos == {{stinger.property_update_qos}}, "Property '{{prop_name|snake_case}}' setter published message with incorrect QoS"
        assert published_msg.retain is False, "Property '{{prop_name|snake_case}}' setter published message with incorrect retain flag"
        assert published_msg.content_type == "application/json", "Property '{{prop_name|snake_case}}' setter published message with incorrect content type"
        published_msg_json_obj = json.loads(published_msg.payload)
        new_{{prop_name | snake_case}}_obj = {{ codec.property_wrap(prop, 'new_' ~ (prop_name|snake_case) ~ '_value') }}
        assert json.loads(new_{{prop_name | snake_case}}_obj.model_dump_json(by_alias=True)) == published_msg_json_obj, "Property '{{prop_name|snake_case}}' setter did not publish the correct JSON payload"

    def test_{{prop_name|snake_case}}_setter_raises_without_a_value(self, monkeypatch, client):
        monkeypatch.setattr(client_module, "PROPERTY_VALUE_TIMEOUT_SECONDS", 0.05)

        with pytest.raises(PropertyValueUnavailableError):
            client.{{prop_name|snake_case}} = {{ codec.property_example(prop) }}
    {%endif%}{# don't generate for readonly#}
    {%- endif %}
    {%endfor%}{# each property#}
{%endif%}
{%if stinger.methods | length > 0 %}
class TestClientMethods:

    {%for method_name, method in stinger.methods.items()%}
    {%- if method.request_payload.is_protobuf %}
    def test_{{method_name|snake_case}}_method_call_sends_request(self, mock_connection, client):
        """A protobuf method takes the request message itself and publishes it as bytes."""
        request = {{method.request_payload.python.class_name}}()
        client.{{method_name|snake_case}}(request)
        assert len(mock_connection.published_messages) == 1, "No message was published for '{{method_name|snake_case}}' method call"
        message = mock_connection.published_messages[0]
        expected_topic = "{{method.request_topic() | regex_replace("\{[A-Za-z_]+\}", "x") }}"
        assert message.topic == expected_topic, f"Incorrect topic for '{{method_name|snake_case}}' method call: {message.topic}"
        assert message.content_type == "application/protobuf", f"'{{method_name|snake_case}}' request was published as '{message.content_type}'"
        assert message.payload == request.SerializeToString(), "Published payload is not the serialized request message"

    def test_{{method_name|snake_case}}_response_resolves_to_the_message(self, mock_connection, client):
        """The future for a protobuf method resolves to the response message, not to a field of it."""
        fut = client.{{method_name|snake_case}}({{method.request_payload.python.class_name}}())
        request_msg = mock_connection.published_messages[0]

        expected = {{method.python.return_value_annotation}}()
        mock_connection.simulate_message(MessageCreator.binary_response_message(
            request_msg.response_topic,
            expected.SerializeToString(),
            "application/protobuf",
            0,
            request_msg.correlation_data,
        ))

        result = fut.result(1)
        assert isinstance(result, {{method.python.return_value_annotation}}), f"The future resolved to {type(result)} rather than the response message"
        assert result == expected, "The future did not resolve to the response that was sent"
    {%- else %}
    def test_{{method_name|snake_case}}_method_call_sends_request(self, mock_connection, client):
        kwargs = {
        {%-for arg in method.arg_list%}
            "{{arg.name|snake_case}}": {{arg.get_random_example_value()}},
        {%endfor-%}
        } # type: Dict[str, Any]
        client.{{method_name|snake_case}}(**kwargs)
        assert len(mock_connection.published_messages) == 1, "No message was published for '{{method_name|snake_case}}' method call"
        message = mock_connection.published_messages[0]
        expected_topic = "{{method.request_topic() | regex_replace("\{[A-Za-z_]+\}", "x") }}"
        assert message.topic == expected_topic, f"Incorrect topic for '{{method_name|snake_case}}' method call: {message.topic}"
    {%- endif %}
    {%endfor%}
{%endif%}
