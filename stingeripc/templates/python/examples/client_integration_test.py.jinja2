    conn = Mqtt5Connection(transport, client_id=os.environ.get("CLIENT_ID", "py-client-integration-test"), lwt=lwt)

    client_builder = {{stinger.python.client_class_name}}Builder()

    {%for sig_name, sig in stinger.signals.items()%}
    @client_builder.receive_{{sig_name | snake_case }}
    def _on_{{sig_name | snake_case}}({% if sig.payload.is_protobuf or sig.arg_list %}{{ codec.handler_params(sig.payload, sig.arg_list) }}, {% endif %}_name="{{sig_name}}"):
