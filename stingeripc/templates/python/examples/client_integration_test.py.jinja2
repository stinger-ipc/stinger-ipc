DISCOVERY_TIMEOUT = float(os.environ.get("DISCOVERY_TIMEOUT_SECONDS", 10))
CHECK_TIMEOUT = float(os.environ.get("CHECK_TIMEOUT_SECONDS", 5))

_results: List[bool] = []


def _check(name: str, passed: bool, detail: str = "") -> bool:
    status = "PASS" if passed else "FAIL"
    print(f"[CHECK] {name} ... {status}{': ' + detail if detail else ''}", flush=True)
    _results.append(passed)
    return passed


def _finish() -> None:
    total = len(_results)
    passed = sum(1 for r in _results if r)
    if total > 0 and passed == total:
        print(f"RESULT: PASS ({passed}/{total} checks)", flush=True)
        os._exit(0)
    else:
        print(f"RESULT: FAIL ({passed}/{total} checks passed)", flush=True)
        os._exit(1)


_signal_events = {{"{"}}{% for sig_name in stinger.signals.keys() %}"{{sig_name}}": threading.Event(){% if not loop.last %}, {% endif %}{% endfor %}{{"}"}}
_signal_values = {}

_property_events = {{"{"}}{% for prop_name in stinger.properties.keys() %}"{{prop_name}}": threading.Event(){% if not loop.last %}, {% endif %}{% endfor %}{{"}"}}
