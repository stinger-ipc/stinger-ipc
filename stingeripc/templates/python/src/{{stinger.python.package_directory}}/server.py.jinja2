    def __init__(self):
        {%if stinger.methods|length == 0 and stinger.commands|length == 0 and (not config.properties.stinger_owned_values or stinger.properties|length == 0) %}pass{%endif%}
        {%for method_name, method in stinger.methods.items()%}
