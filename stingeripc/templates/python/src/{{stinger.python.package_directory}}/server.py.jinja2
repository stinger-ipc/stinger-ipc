        self._{{prop_name|snake_case}}_property_callbacks: List[Callable[[{{property.python.annotation}}], Union[None, Coroutine[Any, Any, None]]]] = []
        {%-endfor%}
        {%endif%}{# only when stinger owned values #}
    {%for method_name, method in stinger.methods.items()%}
    def handle_{{method_name | snake_case}}(self, handler: {{method_type_annotation(method)}}):
        @functools.wraps(handler)
        def wrapper(*args, **kwargs):
            return handler(*args, **kwargs)
        if self._{{method_name|snake_case}}_method_handler is None and handler is not None:
            self._{{method_name|snake_case}}_method_handler = wrapper
        else:
            raise Exception("Method handler already set")
        return wrapper
    {%endfor%}
    {%for command_name, command in stinger.commands.items()%}
    def receive_{{command_name | snake_case}}(self, handler: {{command.python.callback_type_name}}):
        """ {{ docstrings.google_docstring(command.documentation, 8, args=command.arg_list, extra="This method registers a callback to be called whenever the '" ~ command_name ~ "' command is received.") }}
        """
        @functools.wraps(handler)
        def wrapper(*args, **kwargs):
            return handler(*args, **kwargs)
        self._command_recv_callbacks_for_{{command_name|snake_case}}.append(wrapper)
        return wrapper
    {%endfor%}
    {%if config.properties.stinger_owned_values %}
    {%for prop_name, prop in stinger.properties.items()%}
    {%if not prop.read_only %}
    def on_{{prop_name | snake_case}}_updated(self, handler: Callable[[{{prop.python.annotation}}], Union[None, Coroutine[Any, Any, None]]]):
