    Instead, use this builder to create a registry of callbacks, and then build clients using the registry.

    When ready to create a {{stinger.python.client_class_name}} instance, call the `build(broker, service_instance_id)` method.
    """

    def __init__(self):
        """ Creates a new {{stinger.python.client_class_name}}Builder.
        """
        self._logger = logging.getLogger('{{stinger.python.client_class_name}}Builder')
        {%for sig_name in stinger.signals.keys()-%}
        self._signal_recv_callbacks_for_{{sig_name | snake_case}} = [] # type: List[{{sig_name | UpperCamelCase}}SignalCallbackType]
        {%endfor-%}
        {%for prop_name in stinger.properties.keys()-%}
        self._property_updated_callbacks_for_{{prop_name | snake_case}}: List[{{prop_name | UpperCamelCase}}PropertyUpdatedCallbackType] = []
        {%endfor-%}
        self._unmatched_signal_callbacks: List[UnmatchedSignalCallbackType] = []

    {%for sig_name, sig in stinger.signals.items()%}
    def receive_{{sig_name | snake_case }}(self, handler):
        """ Used as a decorator for methods which handle particular signals.
        """
        @wraps(handler)
        def wrapper(*args, **kwargs):
            return handler(*args, **kwargs)
        self._signal_recv_callbacks_for_{{sig_name | snake_case }}.append(wrapper)
        return wrapper
    {%endfor%}

    def unmatched_signal_handler(self, handler: UnmatchedSignalCallbackType):
        """ Used as a decorator for methods which handle signals that did not match any specific signal handler.
        """
        @wraps(handler)
        def wrapper(*args, **kwargs):
            return handler(*args, **kwargs)
        self._unmatched_signal_callbacks.append(wrapper)
        return wrapper

    {%for prop_name, prop in stinger.properties.items()%}
    def {{prop_name|snake_case}}_updated(self, handler: {{prop_name | UpperCamelCase}}PropertyUpdatedCallbackType):
        """ Used as a decorator for methods which handle updates to properties.
        """
        @wraps(handler)
        def wrapper(*args, **kwargs):
            return handler(*args, **kwargs)
        self._property_updated_callbacks_for_{{prop_name | snake_case}}.append(wrapper)
        return wrapper
    {%endfor%}

    def build(self, broker: IBrokerConnection, instance_info: DiscoveredInstance, binding: Optional[Any]=None) -> {{stinger.python.client_class_name}}:
        """ Builds a new {{stinger.python.client_class_name}}.
        """
        self._logger.debug("Building {{stinger.python.client_class_name}} for service instance %s", instance_info.instance_id)
        client = {{stinger.python.client_class_name}}(broker, instance_info)
        {%for sig_name, sig in stinger.signals.items()%}
        for {{sig_name | snake_case }}_cb in self._signal_recv_callbacks_for_{{sig_name | snake_case }}:
            if binding:
                client.receive_{{sig_name | snake_case}}({{sig_name | snake_case }}_cb.__get__(binding, binding.__class__))
            else:
                client.receive_{{sig_name | snake_case}}({{sig_name | snake_case }}_cb)
        {%endfor%}
        for unmatched_signal_cb in self._unmatched_signal_callbacks:
            if binding:
                client.unmatched_signal_handler(unmatched_signal_cb.__get__(binding, binding.__class__))
            else:
                client.unmatched_signal_handler(unmatched_signal_cb)
        {%for prop_name, prop in stinger.properties.items()%}
        for {{prop_name | snake_case}}_cb in self._property_updated_callbacks_for_{{prop_name | snake_case}}:
            if binding:
                client.{{prop_name | snake_case}}_changed({{prop_name | snake_case}}_cb.__get__(binding, binding.__class__))
            else:
                client.{{prop_name | snake_case}}_changed({{prop_name | snake_case}}_cb)
