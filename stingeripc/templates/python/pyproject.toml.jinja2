[project]
name = "{{stinger.python.package_name}}"
version = "{{stinger.version}}"
description = "{{stinger.title}}"

requires-python = {%if config.python.python37%}">=3.7"{%else%}">=3.9"{%endif%}
dependencies = [
    "pydantic{%if config.python.python37%}==2.5.3{%else%}>=2.11.7{%endif%}",
    "paho-mqtt>=2.1.0",
    "isodate>=0.7.2",
    "jsonschema>=4.0.0", # Not the best json schema library.  TODO: use a faster one.
    "pyqttier>=0.2.5",
    "stinger-python-utils>=0.2.0",{% if stinger.uses_protobuf() %}
    "protobuf>=5.29", # This interface carries protobuf payloads.{% endif %}
    {%if config.python.python37%}"typing-extensions>=4.0.0",{%endif%}
]

{%if not config.python.python37%}
[dependency-groups]
dev = [
    "pytest>=8.4.0",
    "mypy>=1.19.1",
    "mypy-gitlab-code-quality==1.3.0",
    "pytest-gitlab-code-quality==0.3.0",
]
docs = [
    "sphinx>=9.1.0",
    "sphinx-autodoc-typehints>=3.13.2",
    "sphinx-rtd-theme>=3.1.0",
]
{%endif%}

[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[tool.setuptools.package-data]
packages = ["{{stinger.python.package_directory}}"{%if stinger.uses_protobuf()%}, "{{stinger.python.package_directory}}.proto"{%endif%}]{% if stinger.uses_protobuf() %}
"{{stinger.python.package_directory}}.proto" = ["*.proto", "*.pyi"]{% endif %}

[stinger-ipc]
generator_version = "{{generator.version}}"

[tool.pytest.ini_options]
pythonpath = ["src"]
