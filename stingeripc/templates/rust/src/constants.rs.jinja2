{% for const_name, const_obj in stinger.constants.items() %}
{% if const_obj.description %}
/// {{ const_obj.description }}
{% endif -%}
{#- The interface author's literal is intentional; it may coincidentally approximate a
    well-known constant like PI without that being a mistake worth flagging. -#}
#[allow(clippy::approx_constant)]
pub const {{ const_name | CONST_CASE }}: {{ const_obj.rust.type }} = {% if const_obj.constant_type == "string" %}"{{ const_obj.value }}"{% elif const_obj.constant_type == "boolean" %}{{ const_obj.value | lower }}{% else %}{{ const_obj.value }}{% endif %};
{% endfor %}
