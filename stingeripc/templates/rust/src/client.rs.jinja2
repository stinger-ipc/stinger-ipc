/// This is the struct for our API client.
#[derive(Clone)]
pub struct {{stinger.rust.client_struct_name}}<C: Mqtt5PubSub> {
    mqtt_client: C,
    {%if stinger.methods | length > 0 or stinger.properties | length > 0 %}/// Temporarily holds oneshot channels for responses to method calls and property update requests.
