impl<C: Mqtt5PubSub + Clone + Send + 'static> {{stinger.rust.client_struct_name}}<C> {

    /// Creates a new {{stinger.rust.client_struct_name}} that uses an Mqtt5PubSub.
    ///
    /// This subscribes only to the aggregate method- and property-response topics.  Signal
    /// and property value topics are subscribed to on first use, so an interface with
    /// neither leaves the connection untouched here.
    pub async fn new({%if stinger.methods|length > 0 or stinger.properties|length > 0%}mut {%endif%}connection: C, discovery_info: DiscoveredService) -> Self {

        // Create a channel for messages to get from the Connection object to this {{stinger.rust.client_struct_name}} object.
        // The Connection object uses a clone of the tx side of the channel.
        let (message_received_tx, message_received_rx) = broadcast::channel(64);

        let client_id = connection.get_client_id();

        {%if stinger.methods|length > 0 or stinger.properties|length > 0%}
        let mut topic_map = HashMap::from([
            ("interface_name".to_string(), "{{stinger.name}}".to_string()),
            ("service_id".to_string(), discovery_info.interface_info.instance.clone()),
            ("client_id".to_string(), client_id.as_str().to_string()),
            {%-for topic_param in config.topics.params%}
            ("{{topic_param}}".to_string(), discovery_info.interface_info.{{topic_param | snake_case}}.as_str().to_string()),
            {%-endfor%}
        ]);
        {%endif%}

        {%if stinger.methods|length > 0%}
        topic_map.insert("method_name".to_string(), "+".to_string());
        let topic_any_method_response = strfmt("{{stinger.all_methods_response_topic()}}", &topic_map).unwrap();
        let subscription_id_any_method_response = connection.subscribe(topic_any_method_response, QoS::ExactlyOnce, message_received_tx.clone()).await;
        let subscription_id_any_method_response = subscription_id_any_method_response.unwrap_or(u32::MAX);
        debug!("Subscription (id={}) to any method response topic", subscription_id_any_method_response);
        {%endif%}

        {%if stinger.signals|length > 0 %}
        // Signal topics are deliberately not subscribed to here.  Each signal is subscribed
        // to when its first receiver is handed out, so a client never receives signals no
        // part of the application is listening for.
        {%endif%}

        {%if stinger.properties|length > 0 %}
        // Property value topics are deliberately not subscribed to here.  Each property is
        // subscribed to on first use -- when it is watched, read or set -- so a client never
        // receives properties it was never asked about.
        {%endif%}
        {%if stinger.properties|length > 0 %}
        topic_map.insert("property_name".to_string(), "+".to_string());
        let topic_any_property_update_response = strfmt("{{stinger.all_properties_response_topic()}}", &topic_map).unwrap();
        let subscription_id_any_property_update_response = connection.subscribe(topic_any_property_update_response, QoS::AtLeastOnce, message_received_tx.clone()).await;
        let subscription_id_any_property_update_response = subscription_id_any_property_update_response.unwrap_or(u32::MAX);
        debug!("Subscription (id={}) to any property update response topic", subscription_id_any_property_update_response);
        {%endif%}

        {%if stinger.properties|length > 0%}
        let property_values = {{stinger.name | UpperCamelCase}}Properties {
        {%-for prop_name, prop in stinger.properties.items()%}
            {{prop_name | snake_case}}: Arc::new(RwLockWatch::new(None)),
            {%-if config.properties.version_tracking%}
            {{prop_name | snake_case}}_version: Arc::new(AtomicU32::new(0)),
            {%-endif%}
        {%-endfor%}
        };
        {%endif%}
        // Create structure for subscription ids.
        let sub_ids = {{stinger.name | UpperCamelCase }}SubscriptionIds {
            {%if stinger.methods|length > 0 -%}
            any_method_response: subscription_id_any_method_response,
            {%endif%}
            {%-for sig_name, sig in stinger.signals.items()-%}
            {{sig_name | snake_case}}_signal: Arc::new(AtomicU32::new(UNSUBSCRIBED_SUBSCRIPTION_ID)),
            {%endfor%}
            {%-for prop_name, prop in stinger.properties.items()-%}
            {{prop_name | snake_case}}_property_value: Arc::new(AtomicU32::new(UNSUBSCRIBED_SUBSCRIPTION_ID)),
            {%endfor%}
            {%if stinger.properties | length > 0 %}
            any_property_update_response: subscription_id_any_property_update_response,
            {%endif%}
        };

        {%if stinger.signals | length > 0 %}// Create structure for the tx side of broadcast channels for signals.
        let signal_channels = {{stinger.name | UpperCamelCase }}SignalChannels {
            {%for sig_name, sig in stinger.signals.items()-%}
            {{sig_name|snake_case}}_sender: broadcast::channel(64).0,
            {%endfor%}
        };{%endif%}

        // Create {{stinger.rust.client_struct_name}} structure.
        {{stinger.rust.client_struct_name}} {
            mqtt_client: connection,
            {%if stinger.methods | length > 0 or stinger.properties | length > 0 %}pending_responses: Arc::new(Mutex::new(HashMap::new())),{%endif%}
            msg_streamer_rx: Arc::new(Mutex::new(Some(message_received_rx))),
            msg_streamer_tx: message_received_tx,
            {%if stinger.properties|length > 0 %}
            properties: property_values,
            {%endif%}
            subscription_ids: sub_ids,
            {%if stinger.signals | length > 0 %}signal_channels,{%endif%}
            client_id,
            service_instance_id: discovery_info.interface_info.instance,
            {%- for topic_param in config.topics.params %}
            topic_param_{{topic_param | snake_case}}: discovery_info.interface_info.{{topic_param | snake_case}},
            {%- endfor %}
        }
    }

    {%for sig_name, sig in stinger.signals.items()-%}
    /// Subscribes to the '{{sig_name}}' signal's topic, at most once.
    ///
    /// Nothing subscribes to signal topics when the client is constructed; the subscription
    /// is made when the first receiver for this signal is handed out.
    async fn ensure_{{sig_name | snake_case}}_signal_subscribed(&self) {
        // Claim the subscription with a compare-exchange, so two concurrent first uses of
        // this signal do not each subscribe.
        if self.subscription_ids.{{sig_name | snake_case}}_signal
            .compare_exchange(
                UNSUBSCRIBED_SUBSCRIPTION_ID,
                SUBSCRIBING_SUBSCRIPTION_ID,
                Ordering::AcqRel,
                Ordering::Acquire,
            )
            .is_err()
        {
            return;
        }

        let mut topic_param_map = self.base_topic_params();
        topic_param_map.insert("signal_name".to_string(), "{{sig_name}}".to_string());
        let topic = strfmt("{{sig.topic()}}", &topic_param_map).unwrap();
        let mut connection = self.mqtt_client.clone();
        match connection.subscribe(topic.clone(), QoS::ExactlyOnce, self.msg_streamer_tx.clone()).await {
            Ok(subscription_id) => {
                debug!("Subscription (id={}) to signal topic for '{{sig_name}}'", subscription_id);
                self.subscription_ids.{{sig_name | snake_case}}_signal.store(subscription_id, Ordering::Release);
            }
            Err(e) => {
                error!("Failed to subscribe to the '{{sig_name}}' signal topic '{}': {:?}", topic, e);
                // Release the claim so a later call can try again.
                self.subscription_ids.{{sig_name | snake_case}}_signal.store(UNSUBSCRIBED_SUBSCRIPTION_ID, Ordering::Release);
            }
        }
    }

    /// Get the RX receiver side of the broadcast channel for the '{{sig_name}}' signal.
    /// The signal payload, `{{sig.payload.rust.class_name}}`, will be put onto the channel whenever it is received.
    ///
    /// Asking for a receiver is what subscribes the client to the '{{sig_name}}' signal, so a
    /// signal nothing listens for is never received.  A broadcast channel does not replay,
    /// so a signal emitted before the first receiver is handed out is still missed.
    pub async fn get_{{sig_name|snake_case}}_receiver(&self) -> broadcast::Receiver<{{sig.payload.rust.channel_type}}> {
        // Take the receiver before subscribing, so a signal arriving while the subscription
        // is being made is not missed.
        let receiver = self.signal_channels.{{sig_name | snake_case}}_sender.subscribe();
        self.ensure_{{sig_name | snake_case}}_signal_subscribed().await;
        receiver
    }
    {%endfor%}

    {%if stinger.signals | length > 0 or stinger.methods | length > 0 or stinger.properties | length > 0 or stinger.commands | length > 0 %}
    /// Builds the topic-template parameters that stay constant for the lifetime of
    /// this client (interface name, service instance id, client id and any
    /// configured topic parameters).  Callers insert the request-specific keys
    /// (such as `method_name` or `property_name`) before formatting a concrete
    /// topic.  Centralizing this avoids repeating the same map literal at every
    /// call site.
    fn base_topic_params(&self) -> HashMap<String, String> {
        HashMap::from([
            ("interface_name".to_string(), "{{stinger.name}}".to_string()),
            ("service_id".to_string(), self.service_instance_id.clone()),
            ("client_id".to_string(), self.client_id.clone()),
            {%-for topic_param in config.topics.params%}
            ("{{topic_param}}".to_string(), self.topic_param_{{topic_param | snake_case}}.clone()),
            {%-endfor%}
        ])
    }
    {%endif%}

    {%if stinger.properties | length > 0 %}
    /// Drives the "local set -> request server update -> await ack" loop for a
    /// single property.  All properties share this one implementation; the
    /// per-property specifics (which payload type to send, how to pull the value
    /// back out of the server's response) are supplied by the `make_payload` and
    /// `extract_value` closures.  This keeps `run_loop` free of one large copy of
    /// this logic per property.
    ///
    /// * `T` is the property's value type (what the application sets).
    /// * `P` is the serializable wire payload for the property: the generated
    ///   `*Property` struct, which wraps `T` in its single named field.
    async fn run_property_update_request_handler<T, P, MakePayload, ExtractValue>(
        property_name: &'static str,
        mut request_rx: tokio::sync::mpsc::Receiver<(Option<T>, Option<oneshot::Sender<Option<Option<T>>>>)>,
        mut publisher: C,
        resp_map: Arc<Mutex<HashMap<Uuid, oneshot::Sender<MethodReturnCode>>>>,
        update_topic: String,
        response_topic: String,
        {%- if config.properties.version_tracking %}
        version: Arc<AtomicU32>,
        {%- endif %}
        make_payload: MakePayload,
        extract_value: ExtractValue,
    ) where
        T: std::fmt::Debug + Send + 'static,
        P: crate::payloads::WirePayload + std::fmt::Debug + Send + 'static,
        MakePayload: Fn(T) -> P + Send + 'static,
        ExtractValue: Fn(P) -> T + Send + 'static,
    {
        while let Some((opt_value, opt_responder)) = request_rx.recv().await {
            // The lock holds an Option because a property's value is unknown until it has
            // been received; there is nothing to ask the server for while it still is.
            let Some(value) = opt_value else {
                warn!("Property {} was set locally to no value; nothing to request of the server", property_name);
                if let Some(responder) = opt_responder {
                    let _ = responder.send(None);
                }
                continue;
            };
            debug!("Property {} has changed locally to {:?}, sending update request to server", property_name, value);
            let payload_obj = make_payload(value);
            let correlation_id = Uuid::new_v4();
            let (sender, receiver) = oneshot::channel();
            {
                let mut hashmap = resp_map.lock().expect("Mutex was poisoned");
                hashmap.insert(correlation_id, sender);
            }
            match message::property_update_request(&update_topic, &payload_obj, {%if config.properties.version_tracking%}version.load(Ordering::Relaxed), {%endif%}correlation_id, response_topic.clone()) {
                Ok(msg) => {
                    debug!("Publishing property update request for '{}' to topic '{}': {:?}", property_name, update_topic, payload_obj);
                    let _publish_result = publisher.publish(msg).await;
                    let result = receiver.await;
                    debug!("Received property update response for '{}': {:?}", property_name, result);
                    match result {
                        Ok(MethodReturnCode::Success(opt_response_text)) => {
                            if let Some(responder) = opt_responder {
                                if let Some(response_text) = opt_response_text {
                                    let resp_obj = <P as crate::payloads::WirePayload>::from_bytes(&response_text).unwrap();
                                    let _ = responder.send(Some(Some(extract_value(resp_obj))));
                                } else {
                                    warn!("No response payload received for property update request for '{}'", property_name);
                                    let _ = responder.send(None);
                                }
                            } else {
                                info!("No responder provided for property update request for '{}'", property_name);
                            }
                        }
                        _ => {
                            warn!("Property update request for '{}' failed: {:?}", property_name, result);
                            if let Some(responder) = opt_responder {
                                let _ = responder.send(None);
                            }
                        }
                    };
                }
                Err(e) => {
                    warn!("Failed to create property update message for '{}': {:?}", property_name, e);
                    if let Some(responder) = opt_responder {
                        let _ = responder.send(None);
                    }
                }
            }
        }
    }
    {%endif%}

    {%for method_name, method in stinger.methods.items()-%}

    async fn start_{{method_name|snake_case}}(
            &mut self,
            {{ payload_params(method.request_payload, method.arg_list) }}{% if method.request_payload.is_protobuf or method.arg_list %},{% endif %}
    ) -> oneshot::Receiver<MethodReturnCode> {
        // Setup tracking for the future response.
        let correlation_id = Uuid::new_v4();
        let (sender, receiver) = oneshot::channel();
        {{ build_payload(method.request_payload, method.arg_list) }}
        {%-if method.arg_list | length > 0 %}
        if let Err(e) = data.validate_schema() {
            error!("Request payload for {{method_name}} failed schema validation, not sending: {}", e);
            let _ = sender.send(MethodReturnCode::ClientSerializationError(format!("Request payload failed schema validation: {}", e)));
            return receiver;
        }
        {%-endif%}

        {
            let mut hashmap = self.pending_responses.lock().expect("Mutex was poisoned");
            hashmap.insert(correlation_id, sender);
        }

        let mut topic_param_map = self.base_topic_params();
        topic_param_map.insert("method_name".to_string(), "{{method_name}}".to_string());
        let request_topic: String = strfmt("{{method.request_topic()}}", &topic_param_map).unwrap();
        let response_topic: String = strfmt("{{method.response_topic()}}", &topic_param_map).unwrap();
        let msg = message::request(&request_topic, &data, correlation_id, response_topic).unwrap();
        info!("Sending request to topic '{}': {:?}", request_topic, data);
        let _ = self.mqtt_client.publish(msg).await;
        receiver
    }

    /// The `{{method_name}}` method.
    /// Method arguments are packed into a {{method.request_payload.rust.class_name}} structure
    /// and published to the `{{method.topic}}` MQTT topic.
    ///
    /// This method awaits on the response to the call before returning.
    pub async fn {{method_name|snake_case}}(&mut self{%if method.request_payload.is_protobuf or method.arg_list %}, {%endif%}{{ payload_params(method.request_payload, method.arg_list) }})->Result<{{method.rust.return_value_type}}, MethodReturnCode> {

        let receiver = self.start_{{method_name|snake_case}}({%if method.request_payload.is_protobuf %}payload{%else%}{%for arg in method.arg_list%}{{arg.name|snake_case}}{%if not loop.last%}, {%endif%}{%endfor%}{%endif%}).await;

        let return_code: MethodReturnCode = receiver.await.unwrap();
        info!("Received response for method '{{method_name}}': {:?}", return_code);
        match return_code {
            MethodReturnCode::Success({%if not method.has_response %}_{%else%}payload_str{%endif%}) => {
                {%if not method.has_response %}
                Ok(())
                {%else%}
                {%- if method.response_payload.is_protobuf %}
                let return_bytes = payload_str.unwrap_or_else(Bytes::new);
                {%- else %}
                let return_bytes = payload_str.unwrap_or_else(|| {{ empty_payload_bytes(method.response_payload) }});
                {%- endif %}
                let return_obj = <{{method.response_payload.rust.struct_name}} as WirePayload>::from_bytes(&return_bytes)
                    .map_err(MethodReturnCode::ClientDeserializationError)?;
                {%- if method.response_payload.is_protobuf %}
                Ok(return_obj)
                {%- else %}
                return_obj.validate_schema().map_err(MethodReturnCode::ClientDeserializationError)?;
                Ok(return_obj.{{method.return_value.name | snake_case}})
                {%- endif %}
                {%endif%}
            },
            _ => {
                Err(return_code)
            }
        }
    }

    {%endfor%}
    {%for cmd_name, cmd in stinger.commands.items()-%}
    /// Sends the `{{cmd_name}}` command.
    /// Command arguments are packed into a {{cmd.rust.payload_struct_name}} structure
    /// and published to the `{{cmd.topic()}}` MQTT topic.
    ///
    /// A command is fire-and-forget: the server sends no response, so there is
    /// nothing to await and no way to learn whether the server acted on it.
    pub async fn send_{{cmd_name|snake_case}}(&mut self{%if cmd.payload.is_protobuf or cmd.arg_list %}, {%endif%}{{ payload_params(cmd.payload, cmd.arg_list) }}) {
        {{ build_payload(cmd.payload, cmd.arg_list) }}
        {%- if not cmd.payload.is_protobuf %}
        if let Err(err) = data.validate_schema() {
            error!("Payload for '{{cmd_name}}' command failed schema validation, not sending: {}", err);
            return;
        }
        {%- endif %}
        let mut topic_param_map = self.base_topic_params();
        topic_param_map.insert("command_name".to_string(), "{{cmd_name}}".to_string());
        let topic: String = strfmt("{{cmd.topic()}}", &topic_param_map).unwrap();
        {%if cmd.version -%}
        let msg = message::stable_command(&topic, &data, "{{cmd.version}}").unwrap();
        {%else -%}
        let msg = message::command(&topic, &data).unwrap();
        {%endif -%}
        info!("Sending '{{cmd_name}}' command to topic '{}': {:?}", topic, data);
        let _ = self.mqtt_client.publish(msg).await;
    }

    {%endfor%}
    {%for prop_name, prop in stinger.properties.items()%}
    /// Subscribes to the `{{prop_name}}` property's value topic, at most once.
    ///
    /// Nothing subscribes to property values when the client is constructed; the
    /// subscription is made the first time the application shows interest in this
    /// property, by watching, reading or setting it.
    async fn ensure_{{prop_name | snake_case}}_property_subscribed(&self) {
        // Claim the subscription with a compare-exchange, so two concurrent first uses of
        // this property do not each subscribe.
        if self.subscription_ids.{{prop_name | snake_case}}_property_value
            .compare_exchange(
                UNSUBSCRIBED_SUBSCRIPTION_ID,
                SUBSCRIBING_SUBSCRIPTION_ID,
                Ordering::AcqRel,
                Ordering::Acquire,
            )
            .is_err()
        {
            return;
        }

        let mut topic_param_map = self.base_topic_params();
        topic_param_map.insert("property_name".to_string(), "{{prop_name}}".to_string());
        let topic = strfmt("{{prop.value_topic()}}", &topic_param_map).unwrap();
        let mut connection = self.mqtt_client.clone();
        match connection.subscribe(topic.clone(), QoS::AtLeastOnce, self.msg_streamer_tx.clone()).await {
            Ok(subscription_id) => {
                debug!("Subscription (id={}) to property value topic for '{{prop_name}}'", subscription_id);
                self.subscription_ids.{{prop_name | snake_case}}_property_value.store(subscription_id, Ordering::Release);
            }
            Err(e) => {
                error!("Failed to subscribe to the '{{prop_name}}' property value topic '{}': {:?}", topic, e);
                // Release the claim so a later call can try again.
                self.subscription_ids.{{prop_name | snake_case}}_property_value.store(UNSUBSCRIBED_SUBSCRIPTION_ID, Ordering::Release);
            }
        }
    }

    /// Watch for changes to the `{{prop_name}}` property.
    ///
    /// This subscribes to the property and returns a `watch::Receiver` that can be awaited
    /// on for changes.  The receiver holds `None` until the server publishes a value, and
    /// `Some(value)` from then on.
    pub async fn watch_{{prop_name | snake_case}}(&self) -> watch::Receiver<Option<{{prop.rust.type}}>> {
        // Take the receiver before subscribing, so a value arriving while the subscription
        // is being made is not missed.
        let receiver = self.properties.{{prop_name | snake_case}}.subscribe();
        self.ensure_{{prop_name | snake_case}}_property_subscribed().await;
        receiver
    }

    /// Returns the current value of the `{{prop_name}}` property.
    ///
    /// Subscribes to the property if it is not subscribed already, then waits up to
    /// `PROPERTY_VALUE_TIMEOUT` for the server to publish a value.  Returns
    /// `MethodReturnCode::Timeout` if none arrives in that time.
    pub async fn get_{{prop_name | snake_case}}(&self) -> Result<{{prop.rust.type}}, MethodReturnCode> {
        self.await_{{prop_name | snake_case}}_property().await
    }

    /// Subscribes to the `{{prop_name}}` property if needed and waits for its first value.
    ///
    {%- if config.properties.version_tracking %}
    /// This backs both reading the property and handing out its lock: an update request has
    /// to carry the version of the value this client last saw, so a writer cannot be given
    /// out before that value is known either.
    {%- else %}
    /// This backs both reading the property and handing out its lock: an update is made
    /// against the value this client last saw, so a writer cannot be given out before that
    /// value is known either.
    {%- endif %}
    async fn await_{{prop_name | snake_case}}_property(&self) -> Result<{{prop.rust.type}}, MethodReturnCode> {
        let mut receiver = self.properties.{{prop_name | snake_case}}.subscribe();
        self.ensure_{{prop_name | snake_case}}_property_subscribed().await;

        if let Some(value) = (*receiver.borrow_and_update()).clone() {
            return Ok(value);
        }

        let wait_for_value = async {
            while receiver.changed().await.is_ok() {
                if let Some(value) = (*receiver.borrow_and_update()).clone() {
                    return Some(value);
                }
            }
            None
        };
        match tokio::time::timeout(PROPERTY_VALUE_TIMEOUT, wait_for_value).await {
            Ok(Some(value)) => Ok(value),
            Ok(None) => Err(MethodReturnCode::Timeout(
                "The '{{prop_name}}' property watch channel closed before a value arrived".to_string(),
            )),
            Err(_) => Err(MethodReturnCode::Timeout(format!(
                "No value for the '{{prop_name}}' property was received within {:?}",
                PROPERTY_VALUE_TIMEOUT
            ))),
        }
    }
    {%if not prop.read_only %}
    /// Requests that the server change the `{{prop_name}}` property, and awaits the
    /// acknowledgment back from the server.
    pub async fn set_{{prop_name | snake_case}}(
            &mut self, 
            value: {{prop.rust.type}}
    ) -> MethodReturnCode {
        let write_request_lock = match self.get_{{prop_name | snake_case}}_handle().await {
            Ok(handle) => handle,
            Err(code) => return code,
        };
        let mut writer = write_request_lock.write().await;
        *writer = Some(value);
        match writer.commit(std::time::Duration::from_secs(5)).await {
            CommitResult::Applied(_) => {
                MethodReturnCode::Success(None)
            },
            CommitResult::TimedOut => MethodReturnCode::Timeout("Timeout waiting for property update acknowledgment".to_string()),
        }   
    }

    /// Returns the lock behind the `{{prop_name}}` property, for a read-modify-write under
    /// a single commit rather than clobbering a concurrent change.
    ///
    {%- if config.properties.version_tracking %}
    /// Subscribes to the property and waits for its current value first, because an update
    /// request has to carry the version of the value this client last saw.
    {%- else %}
    /// Subscribes to the property and waits for its current value first, so the
    /// read-modify-write starts from the value the server last published.
    {%- endif %}
    pub async fn get_{{prop_name | snake_case}}_handle(&self) -> Result<Arc<WriteRequestLockWatch<Option<{{prop.rust.type}}>>>, MethodReturnCode> {
        self.await_{{prop_name | snake_case}}_property().await?;
        Ok(self.properties.{{prop_name | snake_case}}.write_request().into())
    }
    {%else%}
    /// Returns a read-only handle to the `{{prop_name}}` property, after subscribing to it
    /// and waiting for its current value.
    pub async fn get_{{prop_name | snake_case}}_handle(&self) -> Result<Arc<ReadOnlyLockWatch<Option<{{prop.rust.type}}>>>, MethodReturnCode> {
        self.await_{{prop_name | snake_case}}_property().await?;
        Ok(self.properties.{{prop_name | snake_case}}.read_only().into())
    }
    {%endif%}
    {%endfor%}

    {% if stinger.methods|length > 0 or stinger.properties|length > 0 %}
    fn get_return_code_from_message(msg: &MqttMessage) -> MethodReturnCode {
        let mut return_code: MethodReturnCode = MethodReturnCode::Success(Some(msg.payload.clone()));
        if let Some(retval) = msg.user_properties.get("ReturnCode") {
            let opt_dbg_info = msg.user_properties.get("DebugInfo").cloned();
            if let Ok(return_code_u32) = retval.parse::<u32>() {
                if return_code_u32 != 0 {
                    return_code = MethodReturnCode::from_code(return_code_u32, opt_dbg_info);
                } else {
                    info!("Received Debug Info: {:?}", opt_dbg_info);
                }
            }
        }
        return_code
    }
    {%endif%} {# if there are some methods or properties #}

    /// Starts the tasks that process messages received.
    pub async fn run_loop(&mut self) -> Result<(), JoinError> {

        {%if stinger.methods | length > 0 or stinger.properties | length > 0%}// Clone the Arc pointer to the map.  This will be moved into the loop_task.
        let resp_map: Arc<Mutex<HashMap<Uuid, oneshot::Sender<MethodReturnCode>>>> = self.pending_responses.clone();
        {%endif%}
        // Take ownership of the RX channel that receives MQTT messages.  This will be moved into the loop_task.
        let mut message_receiver = {
            let mut guard = self.msg_streamer_rx.lock().expect("Mutex was poisoned");
            guard.take().expect("msg_streamer_rx should be Some")
        };
        {%if stinger.signals | length > 0 %}
        let sig_chans = self.signal_channels.clone();
        {%endif%}
        let sub_ids = self.subscription_ids.clone();
        {%-if stinger.properties|length > 0%}
        let props = self.properties.clone();
        {%-for prop_name, prop in stinger.properties.items()%}
        // Set up the property change request handling task for '{{prop_name}}'.
        if let Some(request_rx) = props.{{prop_name | snake_case}}.take_request_receiver() {
            let mut topic_param_map = self.base_topic_params();
            topic_param_map.insert("property_name".to_string(), "{{prop_name}}".to_string());
            let update_topic = strfmt("{{prop.update_topic()}}", &topic_param_map).unwrap();
            let response_topic = strfmt("{{prop.response_topic()}}", &topic_param_map).unwrap();
            tokio::spawn(Self::run_property_update_request_handler(
                "{{prop_name}}",
                request_rx,
                self.mqtt_client.clone(),
                self.pending_responses.clone(),
                update_topic,
                response_topic,
                {%- if config.properties.version_tracking %}
                props.{{prop_name | snake_case}}_version.clone(),
                {%- endif %}
                |value| {{ property_wrap(prop, 'value') }},
                |resp_obj: {{prop.payload.rust.class_name}}| {{ property_unwrap(prop, 'resp_obj') }},
            ));
        }
        {% endfor %}
        {%endif%}
        let _loop_task = tokio::spawn(async move {
            loop {
                let msg = match message_receiver.recv().await {
                    Ok(msg) => msg,
                    Err(broadcast::error::RecvError::Lagged(n)) => {
                        warn!("Message receiver lagged behind by {} messages", n);
                        continue;
                    }
                    Err(broadcast::error::RecvError::Closed) => {
                        debug!("Message receiver channel closed");
                        break;
                    }
                };
                {% if stinger.methods|length > 0 or stinger.properties|length > 0 %}
                let opt_corr_id: Option<Uuid> = msg.correlation_data.as_ref().and_then(|b| {
                    // Try parsing as 16-byte binary UUID first
                    if b.len() == 16 {
                        Uuid::from_slice(b.as_ref()).ok()
                    } else {
                        // Try parsing as string UUID (36 bytes for hyphenated format)
                        String::from_utf8(b.to_vec())
                            .ok()
                            .and_then(|s| Uuid::parse_str(&s).ok())
                    }
                });
                let return_code = {{stinger.rust.client_struct_name}}::<C>::get_return_code_from_message(&msg);
                {%endif%} {# if there are some methods or properties #}

                if let Some(subscription_id) = msg.subscription_id {
                    match subscription_id {
                        {%if stinger.methods|length > 0%}
                        _i if _i == sub_ids.any_method_response => {
                            debug!("Received method response message");
                            if opt_corr_id.is_some() {
                                let opt_sender = opt_corr_id
                                    .and_then(|uuid| {
                                        let mut hashmap = resp_map.lock().expect("Mutex was poisoned");
                                        hashmap.remove(&uuid)
                                    });
                                if let Some(sender) = opt_sender {
                                    let oss: oneshot::Sender<MethodReturnCode> = sender;
                                    if oss.send(return_code.clone()).is_err() {
                                        warn!("Failed to send method response  to waiting receiver");
                                    }
                                }
                            } else {
                                warn!("Received method response without correlation ID");
                            }
                        },
                        {%endif-%}
                        {%if stinger.properties|length > 0%}
                        _i if _i == sub_ids.any_property_update_response => {
                            debug!("Received property update response message");
                            if opt_corr_id.is_some() {
                                // Find the oneshot::sender channel for the provided correlation id.
                                let opt_sender = opt_corr_id
                                    .and_then(|uuid| {
                                        let mut hashmap = resp_map.lock().expect("Mutex was poisoned");
                                        hashmap.remove(&uuid)
                                    });
                                if let Some(sender) = opt_sender {
                                    // Send the return code back to the waiting property update handler.
                                    let oss: oneshot::Sender<MethodReturnCode> = sender;
                                    if oss.send(return_code.clone()).is_err() {
                                        warn!("Failed to propagate property update response to waiting receiver");
                                    } else {
                                        debug!("Propagated property update response to waiting receiver");
                                    }
                                }
                            } else {
                                warn!("Received property update response without correlation ID");
                            }
                        },
                        {%endif%}
                        {%-for signal_name, signal in stinger.signals.items()%}
                        _i if _i == sub_ids.{{signal_name | snake_case}}_signal.load(Ordering::Relaxed) => {
                            debug!("Received {{signal_name}} signal message");
                            // Find broadcast channel.
                            let chan = sig_chans.{{signal_name | snake_case}}_sender.clone();
                            {{ decode_or(signal.payload, "msg", "payload", signal_name, "continue") | indent(24) }}
                            let _send_result = chan.send(payload);
                        },
                        {%endfor%}
                        {%-for prop_name, prop in stinger.properties.items()%}
                        _i if _i == sub_ids.{{prop_name | snake_case}}_property_value.load(Ordering::Relaxed) => {
                            debug!("Received '{{prop_name}}' property value");
                            let props_copy = props.clone();
                            tokio::spawn(async move {
                                // JSON deserialize into {{prop.payload.rust.class_name}} struct
                                match <{{prop.payload.rust.struct_name}} as WirePayload>::from_bytes(&msg.payload) {
                                    Ok(pl) => {
{%- if not prop.payload.is_protobuf %}
                                        if let Err(e) = pl.validate_schema() {
                                            warn!("Received '{{prop_name}}' property value failed schema validation: {}", e);
                                            return;
                                        }
{%- endif %}
                                        // Get a write-guard and set the local copy of the property value.
                                        let mut guard = props_copy.{{prop_name | snake_case}}.write().await;
                                        debug!("{{prop_name | CONST_CASE}} property value updated: {:?}", {{ property_unwrap(prop, "pl") }});
                                        *guard = Some({{ property_unwrap(prop, 'pl') }}.clone());
                                        {%- if config.properties.version_tracking %}
                                        // Hold onto the write-guard while we set the local copy of the property version.
                                        if let Some(version_str) = msg.user_properties.get("PropertyVersion") {
                                            if let Ok(version_num) = version_str.parse::<u32>() {
                                                props_copy.{{prop_name | snake_case}}_version.store(version_num, std::sync::atomic::Ordering::Relaxed);
                                            }
                                        }
                                        {%- endif %}
                                    },
                                    Err(e) => {
                                        warn!("Failed to deserialize '{}' into {{prop.payload.rust.class_name}}: {}", String::from_utf8_lossy(&msg.payload), e);
                                    }
                                }
                            });
                        },
                        {%endfor%}
                        unhandled_subscription_id => {
                            error!("Received message with unmatched subscription id: {}", unhandled_subscription_id);
                        }
                    }
                } else {
                    error!("Received message without a subscription id");
                }
            }   
        });

        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use tokio::time::{sleep, Duration};
    use stinger_mqtt_trait::mock::MockClient;
    use tracing_subscriber::EnvFilter;
    use crate::interface::InterfaceInfo;

    #[tokio::test]
    async fn mock_client() {
        let _ = tracing_subscriber::fmt().with_test_writer().with_env_filter(EnvFilter::new("{{stinger.rust.package_name|replace('__', '_')}}=debug")).try_init();

        let client_id = "mock_client".to_string();
        let mut mock_mqtt = MockClient::new(client_id.clone());

        let server_topic_param_map = HashMap::from([
            ("interface_name".to_string(), "{{stinger.name}}".to_string()),
            ("service_id".to_string(), "singleton".to_string()),
            ("client_id".to_string(), "server".to_string()),
            {%-for topic_param in config.topics.params%}
            ("{{topic_param}}".to_string(), "x_{{topic_param}}_y".to_string()),
            {%-endfor%}
        ]);

        let topic = strfmt("{{stinger.interface_info_topic()}}", &server_topic_param_map).unwrap();
        let interface_info = crate::interface::InterfaceInfoBuilder::default()
            .interface_name(server_topic_param_map.get("interface_name").unwrap().to_string())
            .title("{{stinger.title}}".to_string())
            .version("{{stinger.version}}".to_string())
            .instance(server_topic_param_map.get("service_id").unwrap().to_string())
            .connection_topic(topic.clone())
            {%-for topic_param in config.topics.params%}
            .{{topic_param}}(server_topic_param_map.get("{{topic_param}}").unwrap().to_string())
            {%-endfor%}
            .build().unwrap();

        let discovery_info = DiscoveredService {
            interface_info: interface_info,
        };

        let mut client = {{stinger.rust.client_struct_name}}::new(mock_mqtt.clone(), discovery_info).await;

        // Start loop task in background.
        let mut client_for_loop = client.clone();
        tokio::spawn(async move {
            let _ = client_for_loop.run_loop().await;
        });

        {%for sig_name, sig in stinger.signals.items()%}
        { // Nothing is subscribed to a signal until a receiver for it is asked for.
            let mut topic_param_map = server_topic_param_map.clone();
            topic_param_map.insert("signal_name".to_string(), "{{sig_name}}".to_string());
            let {{sig_name|snake_case}}_topic = strfmt("{{sig.topic()}}", &topic_param_map).unwrap();

            // `simulate_receive` reports how many subscriptions matched, so a count of zero
            // says the client has not subscribed to this signal's topic.
            let {{sig_name|snake_case}}_msg = MqttMessage::simple({{sig_name|snake_case}}_topic.clone(), QoS::AtLeastOnce, false, Bytes::new());
            assert_eq!(
                mock_mqtt.simulate_receive({{sig_name|snake_case}}_msg.clone()).unwrap(), 0,
                "Subscribed to the '{{sig_name}}' signal topic before a receiver was asked for"
            );

            // Asking for a receiver is what subscribes to the signal.
            let _{{sig_name|snake_case}}_rx = client.get_{{sig_name|snake_case}}_receiver().await;
            assert_eq!(
                mock_mqtt.simulate_receive({{sig_name|snake_case}}_msg).unwrap(), 1,
                "Asking for a '{{sig_name}}' receiver did not subscribe to its signal topic"
            );
        }
        {%endfor%}

        {%for method_name, method in stinger.methods.items()%}
        { // Test calling the {{method_name}} method.
            mock_mqtt.clear_published_messages();
            let _rx = client.start_{{method_name | snake_case}}(
                {{ example_payload_local(method.request_payload, method.arg_list) }}).await;
            let sent_message = mock_mqtt.last_published_message().expect("Expected a method request message to be published");

            assert!(sent_message.response_topic.is_some(), "Expected response_topic to be set on method request message");
            let response_topic = sent_message.response_topic.as_ref().unwrap();
            assert!(!response_topic.contains('+'), "In the method request message, the response_topic should not contain '+'");
            assert!(!response_topic.contains('#'), "In the method request message, the response_topic should not contain '#'");
        }
        {%endfor%}

        {%for cmd_name, cmd in stinger.commands.items()%}
        { // Test sending the {{cmd_name}} command.
            mock_mqtt.clear_published_messages();

            // Example values always satisfy any schema constraint declared on the argument,
            // so the client publishes rather than dropping the command.
            client.send_{{cmd_name | snake_case}}(
                {{ example_payload_local(cmd.payload, cmd.arg_list) }}).await;

            match mock_mqtt.last_published_message() {
                Some(sent_message) => {
                    assert!(sent_message.topic.ends_with("{{cmd_name}}"), "Expected the '{{cmd_name}}' command to be published to its own topic, not '{}'", sent_message.topic);
                    assert!(!sent_message.retain, "Commands are not retained");
                    assert!(sent_message.response_topic.is_none(), "A command has no response, so it must not carry a response topic");
                    assert!(sent_message.correlation_data.is_none(), "A command has no response, so it must not carry correlation data");
                    assert_eq!(sent_message.content_type.as_deref(), Some(<{{cmd.payload.rust.struct_name}} as WirePayload>::content_type()));
                    {%for topic_param in config.topics.params%}
                    {%if '{' + topic_param + '}' in cmd.topic() %}
                    assert!(sent_message.topic.contains(server_topic_param_map.get("{{topic_param}}").unwrap()), "Expected the '{{cmd_name}}' command topic to contain the topic parameter '{{topic_param}}'");
                    {%endif%}
                    {%endfor%}
                }
                None => panic!("Expected the '{{cmd_name}}' command to be published"),
            }
        }
        {%endfor%}

        {% for prop_name, prop in stinger.properties.items() %}
        { // Nothing is subscribed to a property until the application asks for it.
            let mut topic_param_map = server_topic_param_map.clone();
            topic_param_map.insert("property_name".to_string(), "{{prop_name}}".to_string());
            let {{prop_name|snake_case}}_value_topic = strfmt("{{prop.value_topic()}}", &topic_param_map).unwrap();

            // A value message, the way the server would publish it.  `simulate_receive`
            // reports how many subscriptions matched, so a count of zero says the client
            // has not subscribed to this property's value topic.
            let {{prop_name|snake_case}}_payload = {{ property_wrap(prop, property_example(prop)) }};
            let {{prop_name|snake_case}}_msg = crate::message::property_value(&{{prop_name|snake_case}}_value_topic, &{{prop_name|snake_case}}_payload, 1).unwrap();
            assert_eq!(
                mock_mqtt.simulate_receive({{prop_name|snake_case}}_msg.clone()).unwrap(), 0,
                "Subscribed to the '{{prop_name}}' property value topic before the application asked for it"
            );

            // Watching the property is what subscribes to it.
            let _{{prop_name|snake_case}}_watch = client.watch_{{prop_name | snake_case}}().await;
            assert_eq!(
                mock_mqtt.simulate_receive({{prop_name|snake_case}}_msg).unwrap(), 1,
                "Watching the '{{prop_name}}' property did not subscribe to its value topic"
            );
            sleep(Duration::from_millis(50)).await;

            assert!(client.get_{{prop_name | snake_case}}().await.is_ok(), "Expected a value for the '{{prop_name}}' property after the server published one");
        }
        {%if not prop.read_only %}
        { // Test setting the {{prop_name}} property if it is not read-only.
            // Create an example value to set the property to.
            let {{prop_name|snake_case}}_new_value = {{ property_example(prop) }};

            mock_mqtt.clear_published_messages();
            let {{prop_name|snake_case}}_handle = client.get_{{prop_name | snake_case}}_handle().await.expect("Expected a writable handle for '{{prop_name}}'");
            { // Guard scope
                let mut guard = {{prop_name|snake_case}}_handle.write().await;
                *guard = Some({{prop_name|snake_case}}_new_value);
            } // drop guard should send the mqtt request to update the property value on the server.
            sleep(Duration::from_millis(50)).await; // Its not so much the sleep time as the await that allows other async code to complete.

            let sent_message = mock_mqtt.last_published_message().expect("Expected a property update message for '{{prop_name}}' to be published");
            assert!(sent_message.response_topic.is_some(), "Expected response_topic to be set on property update message for '{{prop_name}}'");
            let response_topic = sent_message.response_topic.as_ref().unwrap();
            assert!(!response_topic.contains('+'), "In the property update message for '{{prop_name}}', the response_topic should not contain '+'");
            assert!(!response_topic.contains('#'), "In the property update message for '{{prop_name}}', the response_topic should not contain '#'");
            {%for topic_param in config.topics.params%}
            {%if '{' + topic_param + '}' in prop.update_topic() %}
            assert!(sent_message.topic.contains(server_topic_param_map.get("{{topic_param}}").unwrap()), "Expected the property update for '{{prop_name}}' to contain the topic parameter '{{topic_param}}'");
            {%endif%}
            {%endfor%}
        }
        {% endif %}
        {% endfor %}
    }
