    use tracing_subscriber::EnvFilter;

    fn topic_param_map(service_id: String) -> HashMap<String, String> {
        HashMap::from([
            ("interface_name".to_string(), "{{stinger.name}}".to_string()),
            ("service_id".to_string(), service_id),
            ("client_id".to_string(), "client_abc".to_string()),
            ("property_name".to_string(), "prop_xyz".to_string()),
            {%-for topic_param in config.topics.params%}
            ("{{topic_param}}".to_string(), "{{topic_param}}".to_string()),
            {%-endfor%}
        ])
    }

    fn sample_message(service_id: String) -> MqttMessage {

        let topic_param_map = topic_param_map(service_id.clone());

        let topic = strfmt("{{stinger.interface_info_topic()}}", &topic_param_map).unwrap();

        let info = InterfaceInfo {
            interface_name: "{{stinger.name}}".into(),
            title: "{{stinger.title}}".into(),
            version: "{{stinger.version}}".into(),
            methods: HashMap::new(),
            commands: HashMap::new(),
            instance: service_id.clone(),
            connection_topic: format!("sample/{}", service_id),
            timestamp: "2024-01-01T00:00:00Z".into(),
            {%-for topic_param in config.topics.params %}
            {{topic_param}}: "{{topic_param}}".into(),
            {%-endfor%}
        };
        let payload = serde_json::to_vec(&info).expect("serialize");

        interface_online(&topic, &info, 60).unwrap()
    }

    #[tokio::test]
    async fn collects_unique_instances_and_topics() {
        let interfaces = Arc::new(RwLock::new(HashMap::new()));
        let (notification_tx, mut notification_rx) = broadcast::channel::<DiscoveredService>(32);

        #[cfg(feature = "metrics")]
        let metrics = Arc::new(Mutex::new({{stinger.name|UpperCamelCase}}DiscoveryMetrics::default()));

        {%set iface_count = 5 %}

        {%for i in range(iface_count)%}
        {
            let service_id = "service_{{loop.index}}".to_string();
            
            let msg = sample_message(service_id.clone());

            {{stinger.name|UpperCamelCase}}Discovery::<MockClient>::handle_interface_info_message(
                msg,
                &interfaces,
                &notification_tx,
                #[cfg(feature = "metrics")]
                metrics.clone()
            );
        }
        {%endfor%}

        let interfaces_guard = interfaces.read().unwrap();
        assert_eq!(interfaces_guard.len(), {{iface_count}});
        {%for i in range(iface_count)%}
        assert!(interfaces_guard.contains_key("service_{{loop.index}}"));
        {%endfor%}
    }

    #[tokio::test]
    async fn full_mock_discovery() {
        // This test simulates a full discovery process using the MockClient. It verifies that
        // when interface info messages are published to the discovery topic, the discovery logic
        // correctly processes them and sends notifications about discovered services.

        let _ = tracing_subscriber::fmt().with_test_writer().with_env_filter(EnvFilter::new("{{stinger.name|snake_case}}_ipc=debug")).try_init();
        let service_id = "N".to_string();
        let topic_param_map = topic_param_map(service_id.clone());
        let client_id = topic_param_map.get("client_id").unwrap().clone();

        let mut mock_client = MockClient::new(client_id.clone());
        let discovery = {{stinger.name|UpperCamelCase}}Discovery::new(&mut mock_client).await.unwrap();

        let mut notification_rx = discovery.subscribe();

        // Publish the interface discovery message
        let msg = sample_message(service_id.clone());
        info!("Inject message to {}", msg.topic);
        mock_client.simulate_receive(msg).unwrap();

        let discovered_service = tokio::time::timeout(
            tokio::time::Duration::from_secs(2),
            notification_rx.recv()
        )
        .await
        .expect("timeout waiting for discovery notification")
        .unwrap();
        assert_eq!(discovered_service.interface_info.interface_name, "{{stinger.name}}");

    }
