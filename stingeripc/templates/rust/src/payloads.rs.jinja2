{# Emits an `impl` block with a validate_schema() method for a struct.  The method
   is always generated; fields that declare a JSON schema constraint are checked
   against their schema using the `jsonschema` crate, and a struct with no such
   fields simply returns Ok(()). #}
{%macro validate_schema_impl(struct_name, arg_list) -%}
{%-set schema_args = arg_list | selectattr('value_schema') | list -%}
#[allow(dead_code)]
impl {{struct_name}} {
    /// Validate fields that declare a JSON schema constraint.
    ///
    /// Returns `Ok(())` if all schema-constrained fields conform to their schema,
    /// or if no field declares a schema.  Returns `Err` with a description if a
    /// constrained field's value does not conform.
    pub fn validate_schema(&self) -> Result<(), String> {
        {%-for arg in schema_args%}
        {
            let schema: serde_json::Value = serde_json::from_str(r##"{{arg.value_schema | tojson}}"##)
                .map_err(|e| format!("embedded schema for field '{{arg.name}}' is invalid: {}", e))?;
            let instance = serde_json::to_value(&self.{{arg.name | snake_case}})
                .map_err(|e| format!("could not serialize field '{{arg.name}}': {}", e))?;
            let validator = jsonschema::validator_for(&schema)
                .map_err(|e| format!("could not build validator for field '{{arg.name}}': {}", e))?;
            validator.validate(&instance)
                .map_err(|e| format!("field '{{arg.name}}' failed schema validation: {}", e))?;
        }
        {%-endfor%}
        Ok(())
    }
}
{%-endmacro %}

