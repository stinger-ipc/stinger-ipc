[package]
name = "{{stinger.rust.package_name}}"
version = "{{stinger.version}}"
edition = "2021"

[features]
default = ["payloads"]
client = ["payloads", "tracing", "tracing-subscriber", "stinger-rwlock-watch/read_only", "stinger-rwlock-watch/write_request"]
server = ["payloads", "async-trait", "tracing", "tracing-subscriber", "stinger-rwlock-watch/write_request"]
payloads = []
metrics = ["payloads"]
lwt = ["stinger-mqtt-trait/lwt", "mqttier/lwt", "dep:jsonpath-rust"]

[dependencies]
# Core dependencies (always available)
futures = "0.3.31"
stinger-mqtt-trait = "0.7.1"
serde = { version = "1.0.219", features = ["derive"] }
serde_json = "1.0.142"
tokio = { version = "1", features = ["rt", "rt-multi-thread", "macros", "sync", "time"] }
num-derive = "0.4.2"
num-traits = "0.2.19"
chrono = "0.4.42"
derive_builder = "0.20"
tracing = { version = "0.1.41", optional = true }
tracing-subscriber = { version = "0.3", optional = true, features = ["env-filter", "fmt"] }
bytes = "1.10.1"
async-trait = { version = "0.1", optional = true } # For server-side async traits
stinger-rwlock-watch = "0.3.7"
strfmt = "0.2.5"
jsonpath-rust = { version = "0.7", optional = true }
{%- if stinger.uses_schemas() %}
jsonschema = "0.46" # Only needed because this interface declares JSON schema constraints.
{%- endif %}
{%- if stinger.uses_binary() %}
base64 = "0.22.1" # Only needed because this interface has binary fields.
{%- endif %}
{%- if stinger.uses_duration() %}
iso8601-duration = "0.2.0" # Only needed because this interface has duration fields.
{%- endif %}

[dependencies.uuid]
version = "1.17.0"
features = [
    "v4", # Lets you generate random UUIDs
]

[dev-dependencies]
mqttier = "0.9.1"
stinger-mqtt-trait = { version = "0.7.1", features = ["mock_client"] }

[[example]]
name = "{{stinger.name|snake_case}}_client_demo"
path = "examples/client_demo.rs"
required-features = ["client"]

[[example]]
name = "{{stinger.name|snake_case}}_server_demo" 
path = "examples/server_demo.rs"
required-features = ["server"]
