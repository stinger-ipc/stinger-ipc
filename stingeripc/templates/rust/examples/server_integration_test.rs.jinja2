fn env_secs(name: &str, default: u64) -> Duration {
    Duration::from_secs(std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default))
}

/// Collects every `[CHECK]` this server can itself verify (method calls,
/// commands, and writable-property updates - a signal is verified by the
/// client that receives it, not by the server that sends it), shared across
/// the method-handler trait object, the command receiver tasks, and the
/// property-watcher tasks.
///
/// An interface with none of those (e.g. signals only) never calls `check`,
/// which is fine - `EXPECTED_CHECKS` is 0 and the server reports a trivial
/// pass without ever constructing a check.
#[allow(dead_code)]
struct ResultsTracker {
    passed: std::sync::Mutex<usize>,
}

impl ResultsTracker {
    fn new() -> Self {
        Self { passed: std::sync::Mutex::new(0) }
    }

    #[allow(dead_code)]
    fn check(&self, name: &str, passed: bool, detail: &str) -> bool {
        let status = if passed { "PASS" } else { "FAIL" };
        if detail.is_empty() {
            println!("[CHECK] {} ... {}", name, status);
        } else {
            println!("[CHECK] {} ... {}: {}", name, status, detail);
        }
        if passed {
            *self.passed.lock().unwrap() += 1;
        }
        passed
    }

    fn passed_count(&self) -> usize {
        *self.passed.lock().unwrap()
    }
}

